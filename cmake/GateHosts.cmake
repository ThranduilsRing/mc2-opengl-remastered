# Host capabilities for the merge gate: reads tools/gate_hosts.json (the same file tools/gate_hosts.py and lane_merge --pre-gate read).
# The host is $ENV{MC2_GATE_HOST} (tools/laptop_gate.py sets it to "laptop"), else the file's "default".
# Sets MC2_HOST_MFC (ON/OFF): the host can compile the MFC Mission Editor (EditRel, gameos_editor). An unknown host is OFF.
function(mc2_read_gate_host_caps)
    set(_file "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../tools/gate_hosts.json")
    set(_mfc OFF)
    if(EXISTS "${_file}")
        if(NOT CMAKE_SCRIPT_MODE_FILE)   # a configure re-runs when the host table changes (not scriptable under cmake -P)
            set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_file}")
        endif()
        file(READ "${_file}" _json)
        set(_host "$ENV{MC2_GATE_HOST}")
        if(NOT _host)
            string(JSON _host GET "${_json}" default)
        endif()
        string(TOLOWER "${_host}" _host)
        string(JSON _val ERROR_VARIABLE _err GET "${_json}" hosts "${_host}" mfc)
        if(NOT _err AND _val)
            set(_mfc ON)
        endif()
        message(STATUS "gate host '${_host}': MFC=${_mfc} (tools/gate_hosts.json)")
    else()
        message(STATUS "tools/gate_hosts.json absent: assuming MFC is available")
        set(_mfc ON)
    endif()
    set(MC2_HOST_MFC ${_mfc} PARENT_SCOPE)
endfunction()
