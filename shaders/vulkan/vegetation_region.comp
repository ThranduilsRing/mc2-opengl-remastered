// Vegetation GPU cull, level 1: region sphere vs frustum planes and MC2_VEG_MAX_DIST in ONE workgroup. Visible regions are
// ballot-compacted (region order preserved) into visList[]; args[12..14] become the indirect dispatch the per-region cull and
// compact passes run over, so the 12k mostly-culled regions never launch a workgroup. The draw arguments are reset to an empty draw
// here; the cull pass overwrites them when at least one region is visible.
#version 450
#extension GL_GOOGLE_include_directive : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_ballot : require
layout(local_size_x = 128) in;
#include "include/vegetation_cull_common.glsl"
shared uint s_bin[128];      // this chunk's region bins (0xffffffff = not visible)
shared uint s_start[128];    // first write position per distance bin
shared uint s_reg[128];      // this chunk's visible regions, compacted in lane order
shared uint s_sub[128];      // visible count per subgroup
// Visible regions are written NEAR TO FAR (128 bins, finer near the camera, stable region order inside a bin): the depth pre-pass (GREATER)
// then rejects far overdraw at the early depth test. The result (nearest cutout wins) is order independent, counts[]/offsets[] are
// indexed by position in visList, so only the draw order changes. Deterministic: no atomics decide the order.
uint regionBin(uint r, bool force) {
    VegRegion R = region[r];
    float d = distance(R.sphere.xyz, P.cam.xyz);
    if (!force) {
        bool outside = false;
        for (int k = 0; k < 4; ++k)
            if (P.plane[k].x * R.sphere.x + P.plane[k].y * R.sphere.y + P.plane[k].z * R.sphere.z + P.plane[k].w < -R.sphere.w * P.planeLen[k]) outside = true;
        // Mixed regions must reach the grass endpoint; per-instance LOD retains the woody range.
        if (outside || d > 12.0 * P.cam.w + R.sphere.w) return 0xffffffffu;
    }
    return min(127u, uint(sqrt(clamp(d / (12.0 * P.cam.w + 1.0), 0.0, 1.0)) * 128.0));
}
void main() {
    uint lid = gl_LocalInvocationIndex, regions = P.counts.x;
    bool force = P.flags.x != 0u;
    s_start[lid] = 0u;
    barrier();
    // Pass 1: histogram of bins (shared atomics; only the counts, not the order, come from them).
    for (uint c = 0u; c < regions; c += 128u) {
        uint r = c + lid;
        if (r < regions) { uint bn = regionBin(r, force); if (bn != 0xffffffffu) atomicAdd(s_start[bn], 1u); }
    }
    barrier();
    // Exclusive prefix over the 128 bins, one thread per bin via a serial scan of the shared counts by thread 0.
    if (lid == 0u) {
        uint run = 0u;
        for (uint i = 0u; i < 128u; ++i) { uint t = s_start[i]; s_start[i] = run; run += t; }
        s_bin[0] = run;
    }
    barrier();
    uint base = s_bin[0];
    barrier();
    // Pass 2: stable placement. A region's slot = bin start + same-bin regions of earlier chunks + same-bin lower lanes of its chunk.
    // Each chunk's visible regions are ballot-compacted (lane order kept) into s_bin/s_reg, then thread lid (the owner of bin lid) walks only
    // the visible entries and appends its bin's regions in order: the same slots as a per-lane rank, without a 128-wide scan per chunk.
    uint pos = s_start[lid];
    for (uint c = 0u; c < regions; c += 128u) {
        uint r = c + lid;
        uint bn = r < regions ? regionBin(r, force) : 0xffffffffu;
        bool vis = bn != 0xffffffffu;
        uvec4 ballot = subgroupBallot(vis);
        if (subgroupElect()) s_sub[gl_SubgroupID] = subgroupBallotBitCount(ballot);
        barrier();
        uint before = 0u, chunk = 0u;
        for (uint s = 0u; s < gl_NumSubgroups; ++s) { uint t = s_sub[s]; if (s < gl_SubgroupID) before += t; chunk += t; }
        if (vis) { uint k = before + subgroupBallotExclusiveBitCount(ballot); s_bin[k] = bn; s_reg[k] = r; }
        barrier();
        for (uint k = 0u; k < chunk; ++k)
            if (s_bin[k] == lid) visList[pos++] = s_reg[k];
        barrier();
    }
    if (lid == 0u) {
        args[0] = 8u; args[1] = 0u; args[2] = 0u; args[3] = 0u;
        args[4] = 8u; args[5] = 0u; args[6] = 8u; args[7] = 0u;
        args[8] = 0u; args[9] = 0u; args[10] = 0u;
        // VkDispatchIndirectCommand at byte 48; x is also the visible region count read by cull and compact. 65535 is the guaranteed
        // maxComputeWorkGroupCount[0]; the host refuses a population with more regions than that.
        args[12] = min(base, 65535u); args[13] = 1u; args[14] = 1u;
    }
}
