// Spatial, water-only SSR. Alpha is coverage; missing/offscreen geometry uses the
// water material's HDRI/SH sky. No history, jitter, readback or scene re-submission.
#version 450
layout(local_size_x=8, local_size_y=8) in;
layout(set=0,binding=0,std140) uniform WaterVsParams {
    mat4 worldToClip;
    vec4 p0, p1, p2, p3;
    mat4 invWorldToClip;   // inverse(worldToClip), computed once on the CPU
} U;
layout(set=0,binding=1,std140) uniform WaterFsParams {
    vec4 fogColor, f0;
} F;
layout(set=0,binding=9) uniform sampler2D sceneColor;
layout(set=0,binding=10) uniform sampler2D sceneDepth;
layout(set=0,binding=11,rgba16f) writeonly uniform image2D reflectionOut;
// 8x8 tiles (full-res reflection image) that contain admitted water (water_cull_pack); one workgroup per entry (indirect 2-D dispatch,
// ROW_TILES wide: water_draw_args pads the last row with 0xFFFFFFFF).
layout(set=0,binding=12,std430) readonly buffer WaterTiles { uint tiles[]; };

vec3 unproject(mat4 inv, vec2 uv, float depth) {
    vec4 h = inv * vec4(uv*2.0-1.0,depth,1.0);
    return h.xyz/h.w;
}

// TREE-REFL-SOLID: foliage is alpha-tested cards, so the depth and colour the march reads keep
// every leaf hole (and overlapping cards cut holes in each other). Dilate to the nearest (reverse-Z:
// largest) depth over a small window so a canopy is a closed silhouette, and return the UV of that
// nearest texel so the reflected colour is leaf colour, never the background seen through a hole.
vec2 gSceneTexel;
float nearestDepth(vec2 uv, out vec2 nearUV) {
    nearUV=uv;
    float z=textureLod(sceneDepth,uv,0).r;
    // WATER-REFLECT-SMOOTH: a round 8-tap ring; the 4 square corners made the stair steps.
    const vec2 k[8]=vec2[8](vec2(-3,0),vec2(3,0),vec2(0,-3),vec2(0,3),vec2(-2,-2),vec2(2,-2),vec2(-2,2),vec2(2,2));
    for (int j=0;j<8;++j) {
        vec2 u=uv+k[j]*gSceneTexel;
        float d=textureLod(sceneDepth,u,0).r;
        if (d>z) { z=d; nearUV=u; }
    }
    return z;
}
// Coverage-weighted colour: mean of the texels around the hit that sit on the same object (within
// 24 wu of the hit in world space), so the reflected colour is a smooth leaf mean, not one texel.
vec3 coverageColour(mat4 inv, vec3 hit, vec2 nuv) {
    vec3 sum=vec3(0); float wsum=0.0;
    for (int y=-1;y<=1;++y) for (int x=-1;x<=1;++x) {
        vec2 u=nuv+vec2(x,y)*1.5*gSceneTexel;
        float d=textureLod(sceneDepth,u,0).r;
        vec3 p=unproject(inv,u,d);
        float w=(x==0&&y==0)?2.0:1.0;
        if (length(p-hit)<24.0) { sum+=textureLod(sceneColor,u,0).rgb*w; wsum+=w; }
    }
    return wsum>0.0?sum/wsum:textureLod(sceneColor,nuv,0).rgb;
}
void main() {
    ivec2 size=imageSize(reflectionOut);
    int tilesX=(size.x+7)/8;
    const uint ROW_TILES=1024u;   // keep equal to water_reflect_dispatch.h kReflectRowTiles
    uint tile=tiles[gl_WorkGroupID.y*ROW_TILES+gl_WorkGroupID.x];
    if (tile==0xFFFFFFFFu) return;
    ivec2 pixel=ivec2(int(tile)%tilesX,int(tile)/tilesX)*8+ivec2(gl_LocalInvocationID.xy);
    if (any(greaterThanEqual(pixel,size))) return;
    imageStore(reflectionOut,pixel,vec4(0));
    gSceneTexel=1.0/vec2(textureSize(sceneDepth,0));
    vec2 uv=(vec2(pixel)+0.5)/vec2(size);
    mat4 inv=U.invWorldToClip;
    // The legacy projection's signed far plane lies behind the eye. Both
    // depths below are on its visible branch, so the ray points into the scene.
    vec3 nearP=unproject(inv,uv,1.0), farP=unproject(inv,uv,0.5);
    vec3 ray=normalize(farP-nearP);
    if (ray.z>=-0.0001) return;
    float distanceToPlane=(U.p0.x-nearP.z)/ray.z;
    vec3 origin=nearP+ray*distanceToPlane;
    vec4 start=U.worldToClip*vec4(origin,1.0);
    if (start.w<=0.0) return;
    // Raster water owns coverage. Its shore depth-only lift can cover coarse
    // terrain above this physical plane, so opaque depth cannot reject it here.
    vec3 reflected=reflect(ray,vec3(0,0,1));
    vec3 endWorld=origin+reflected*65536.0;
    vec4 finish=U.worldToClip*vec4(endWorld,1.0);
    // Clip before perspective division, including rays towards the camera.
    if (finish.w<0.01) {
        float t=(start.w-0.01)/(start.w-finish.w);
        endWorld=mix(origin,endWorld,t);
        finish=U.worldToClip*vec4(endWorld,1.0);
    }
    vec2 beginUV=start.xy/start.w*0.5+0.5;
    vec2 delta=finish.xy/finish.w*0.5+0.5-beginUV;
    float extent=1.0;
    for (int axis=0;axis<2;++axis) {
        if (abs(delta[axis])>0.00001)
            extent=min(extent,((delta[axis]>0.0?0.999:0.001)-beginUV[axis])/delta[axis]);
    }
    if (extent<=0.0 || length(delta*extent*vec2(size))<2.0) return;
    vec3 q0=origin/start.w, q1=endWorld/finish.w;
    float k0=1.0/start.w, k1=1.0/finish.w;
    float previous=0.0;
    vec2 nuv;
    float previousGap=nearestDepth(beginUV,nuv)-start.z/start.w;
    const int STEPS=64;
    for (int i=1;i<=STEPS;++i) {
        float t=extent*float(i)/float(STEPS);
        vec2 hitUV=beginUV+delta*t;
        float sceneZ=nearestDepth(hitUV,nuv);
        float rayZ=mix(start.z/start.w,finish.z/finish.w,t);
        float gap=sceneZ-rayZ;
        // Reflected rays may travel towards or away from the eye. Find either
        // crossing direction; a one-sided test loses high-angle reflections.
        if ((gap>=0.0)!=(previousGap>=0.0)) {
            float lo=previous, hi=t;
            for (int refine=0;refine<8;++refine) {
                float mid=(lo+hi)*0.5;
                vec2 midUV=beginUV+delta*mid;
                float midGap=nearestDepth(midUV,nuv)-mix(start.z/start.w,finish.z/finish.w,mid);
                if ((midGap>=0.0)==(previousGap>=0.0)) lo=mid;
                else hi=mid;
            }
            hitUV=beginUV+delta*hi;
            vec3 hit=unproject(inv,hitUV,nearestDepth(hitUV,nuv));
            vec3 rayPoint=mix(q0,q1,hi)/mix(k0,k1,hi);
            // Reject the underside, lakebed and depth discontinuities. A miss
            // remains transparent rather than stretching an edge texel.
            // TREE-REFL-SOLID: the depth buffer holds only an object's camera-facing
            // surface, so a ray through a canopy crosses it up to a crown's depth
            // behind that surface. A 12 wu shell accepted only the rays that grazed it
            // and reflected trees as see-through dots; accept an object-sized shell.
            if (hit.z>U.p0.x+1.0 && length(hit-rayPoint)<max(64.0,length(hit-origin)*0.03)) {
                // The hit is the dilated texel, so colour comes from that texel. No screen-edge fade: it
                // thinned the reflected canopy toward the left edge; only the last texel row is feathered.
                vec2 edge=min(hitUV,1.0-hitUV);
                float confidence=smoothstep(0.0,0.004,min(edge.x,edge.y));
                imageStore(reflectionOut,pixel,vec4(coverageColour(inv,hit,nuv)*confidence,confidence));
                return;
            }
        }
        previous=t;
        previousGap=gap;
    }
}
