#version 450
layout(local_size_x = 16, local_size_y = 16) in;
layout(rgba16f, set = 0, binding = 0) readonly uniform image2D coverage;
layout(std430, set = 0, binding = 1) buffer Horizontal { float horizontal[]; };
layout(std430, set = 0, binding = 2) writeonly buffer Depth { float depth[]; };
layout(push_constant) uniform Params { int vertical; } P;
void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy), size = imageSize(coverage);
    ivec2 blocks = (size + 7) / 8;
    int mode = P.vertical & 3, count = blocks.x * blocks.y;
    bool halfRes = (P.vertical & 4) != 0;
    if (any(greaterThanEqual(p, mode == 3 ? size : blocks))) return;
    if (mode == 3) {
        if (halfRes && any(notEqual(p % 2, ivec2(0)))) return;
        bool wet = horizontal[(p.y/8)*blocks.x+p.x/8] != 0.0;
        depth[halfRes ? (p.y/2)*size.x+p.x/2 : p.y*size.x+p.x] = wet ? 0.0 : 1.0;
        return;
    }
    bool wet = false;
    if (mode == 0) {
        for (int y = 0; y < 8 && !wet; ++y)
            for (int x = 0; x < 8 && !wet; ++x) {
                ivec2 q = p*8 + ivec2(x,y);
                if (all(lessThan(q,size))) wet = imageLoad(coverage,q).a != 0.0;
            }
        horizontal[p.y*blocks.x+p.x] = wet ? 1.0 : 0.0;
        return;
    }
    bool vertical = mode == 2;
    // Round the original pixel radius up to blocks: the mask stays a superset.
    int radius = (int(ceil(float(vertical ? size.y : size.x) * 0.009)) + (halfRes ? 2 : 1) + 7) / 8;
    for (int i = -radius; i <= radius && !wet; ++i) {
        ivec2 q = clamp(p + (vertical ? ivec2(0,i) : ivec2(i,0)), ivec2(0), blocks-1);
        wet = horizontal[(vertical ? count : 0)+q.y*blocks.x+q.x] != 0.0;
    }
    horizontal[(vertical ? 0 : count)+p.y*blocks.x+p.x] = wet ? 1.0 : 0.0;
}
