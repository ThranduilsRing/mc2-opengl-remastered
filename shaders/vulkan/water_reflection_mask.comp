#version 450
layout(local_size_x = 16, local_size_y = 16) in;
layout(rgba16f, set = 0, binding = 0) readonly uniform image2D coverage;
layout(std430, set = 0, binding = 1) buffer Horizontal { float horizontal[]; };
layout(std430, set = 0, binding = 2) writeonly buffer Depth { float depth[]; };
layout(push_constant) uniform Params { int vertical; } P;
void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy), size = imageSize(coverage);
    if (any(greaterThanEqual(p, size))) return;
    bool vertical = (P.vertical & 1) != 0, halfRes = (P.vertical & 2) != 0;
    if (vertical && halfRes && any(notEqual(p % 2, ivec2(0)))) return;
    // Extra texel covers both the bilinear footprint and the downsample footprint.
    int radius = int(ceil(float(vertical ? size.y : size.x) * 0.009)) + (halfRes ? 2 : 1);
    bool wet = false;
    for (int i = -radius; i <= radius && !wet; ++i) {
        ivec2 q = clamp(p + (vertical ? ivec2(0,i) : ivec2(i,0)), ivec2(0), size-1);
        wet = vertical ? horizontal[q.y*size.x+q.x] != 0.0 : imageLoad(coverage,q).a != 0.0;
    }
    int index = p.y*size.x+p.x;
    if (vertical) depth[halfRes ? (p.y/2)*size.x+p.x/2 : index] = wet ? 0.0 : 1.0;
    else horizontal[index] = wet ? 1.0 : 0.0;
}
