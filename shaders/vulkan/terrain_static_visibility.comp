#version 450
// Conservative visibility tiles preserve every depth comparison at shadow boundaries.
layout(local_size_x=8, local_size_y=8) in;
layout(set=0, binding=0) uniform sampler2D staticDepth;
layout(set=0, binding=1, rgba32f) writeonly uniform image2D visibilityTiles;
shared float lowDepth[64];
shared float highDepth[64];
void main() {
    ivec2 size = textureSize(staticDepth, 0);
    ivec2 origin = ivec2(gl_WorkGroupID.xy) * 32;
    float lo = 1.0, hi = 0.0;
    for (int y=0; y<4; ++y) for (int x=0; x<4; ++x) {
        ivec2 p = origin + ivec2(gl_LocalInvocationID.xy) + ivec2(x,y)*8;
        float d = all(lessThan(p,size)) ? texelFetch(staticDepth,p,0).r : 1.0;
        lo = min(lo,d); hi = max(hi,d);
    }
    uint lane = gl_LocalInvocationIndex;
    lowDepth[lane] = lo; highDepth[lane] = hi;
    barrier();
    for (uint stride=32; stride>0; stride>>=1) {
        if (lane < stride) {
            lowDepth[lane] = min(lowDepth[lane],lowDepth[lane+stride]);
            highDepth[lane] = max(highDepth[lane],highDepth[lane+stride]);
        }
        barrier();
    }
    if (lane==0) imageStore(visibilityTiles,ivec2(gl_WorkGroupID.xy),vec4(lowDepth[0],highDepth[0],0,0));
}
