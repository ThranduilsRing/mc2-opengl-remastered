// Render-only static-prop occlusion. Bounds were projected with this draw's matrix.
#version 450
#extension GL_GOOGLE_include_directive : require
#include "../include/gpu_abi_static_prop_instance.gen.hglsl"
#include "../include/axis.hglsl"
layout(local_size_x = 64) in;
struct Bounds { vec4 pixels; float nearest; uint lod; uint keep; uint pad; };
layout(set = 0, binding = 0) uniform sampler2D levelDepth;
layout(std430, set = 0, binding = 1) buffer ProjectedBounds { Bounds bounds[]; };
layout(std430, set = 0, binding = 2) buffer Visibility { uint culled; uint visible[]; };
layout(std430, set = 0, binding = 3) readonly buffer Instances { GpuStaticPropInstance instances[]; };
struct LocalBounds { vec4 lo; vec4 hi; };
layout(std430, set = 0, binding = 4) readonly buffer TypeBounds { LocalBounds types[]; };
layout(push_constant) uniform Params {
    uint count; uint level; uint typeCount; uint levels;
    mat4 worldToClip;
    vec4 viewportDepth;
} params;

// Project once in the first level dispatch. Later levels read the footprint
// through the existing compute barrier, preserving the CPU reference's keep rules.
Bounds projectProp(uint id) {
    Bounds b = Bounds(vec4(0), 0, 0u, 1u, 0u);
    GpuStaticPropInstance inst = instances[id];
    if (inst.typeID >= params.typeCount || types[inst.typeID].lo.w == 0) return b;
    LocalBounds local = types[inst.typeID];
    vec2 lo = vec2(3.402823466e+38), hi = -lo;
    float nearest = 0;
    for (int corner = 0; corner < 8; ++corner) {
        vec4 p = vec4((corner & 1) != 0 ? local.hi.x : local.lo.x,
                      (corner & 2) != 0 ? local.hi.y : local.lo.y,
                      (corner & 4) != 0 ? local.hi.z : local.lo.z, 1);
        precise vec3 stuff = vec3(0);
        for (int a = 0; a < 3; ++a)
            for (int k = 0; k < 4; ++k) stuff[a] += p[k] * inst.modelMatrix[a][k];
        vec4 world = vec4(mc2ToRender(stuff), 1);
        precise vec4 clip = vec4(0);
        for (int a = 0; a < 4; ++a)
            for (int k = 0; k < 4; ++k) clip[a] += params.worldToClip[k][a] * world[k];
        if (!(clip.w > 1e-5)) return b;
        vec3 ndc = clip.xyz / clip.w;
        ndc.z += params.viewportDepth.z;
        if (any(isnan(ndc)) || any(isinf(ndc)) || ndc.z < 0 || ndc.z >= 1 ||
            any(lessThanEqual(ndc.xy, vec2(-1))) || any(greaterThanEqual(ndc.xy, vec2(1)))) return b;
        vec2 pixels = (ndc.xy + 1) * 0.5 * params.viewportDepth.xy;
        lo = min(lo, pixels); hi = max(hi, pixels);
        nearest = max(nearest, ndc.z);
    }
    b.pixels = vec4(max(vec2(0), floor(lo) - 1), min(params.viewportDepth.xy - 1, ceil(hi) + 1));
    float extent = max(b.pixels.z - b.pixels.x, b.pixels.w - b.pixels.y);
    while (b.lod + 1 < params.levels && float(1u << b.lod) < extent) ++b.lod;
    b.nearest = nearest;
    b.keep = 0u;
    return b;
}
void main() {
    uint id = gl_GlobalInvocationID.x;
    if (id >= params.count) return;
    if (params.level == 0u) bounds[id] = projectProp(id);
    if (bounds[id].lod != params.level) return;
    Bounds b = bounds[id];
    bool hidden = false;
    if (b.keep == 0u) {
        // Ceil ladder uses exact integer 2x2 footprints, including odd extents.
        float scale = float(1u << params.level);
        ivec2 hi = textureSize(levelDepth, 0) - 1;
        ivec2 p0 = clamp(ivec2(floor(b.pixels.xy / scale)), ivec2(0), hi);
        ivec2 p1 = clamp(ivec2(floor(b.pixels.zw / scale)), ivec2(0), hi);
        float farthest = 1.0;
        for (int y = p0.y; y <= p1.y; ++y)
            for (int x = p0.x; x <= p1.x; ++x)
                farthest = min(farthest, texelFetch(levelDepth, ivec2(x,y), 0).r);
        hidden = b.nearest < farthest - 0.00002;
    }
    visible[id] = hidden ? 0u : 1u;
    if (hidden) atomicAdd(culled, 1u);
}
