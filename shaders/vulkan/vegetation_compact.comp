// Re-evaluate only surviving regions after the prefix sum. This keeps population
// order without a population-sized scratch copy; the dense output has a fixed cap.
// The region writes only its own slot range [offsets[r], next start): under the visible
// cap the scan scaled those ranges, so the region keeps an even subset of its survivors
// (survivor j takes slot floor(j*quota/n)), and a cull/compact disagreement can never
// spill into the next region's slots.
#version 450
#extension GL_GOOGLE_include_directive : require
layout(local_size_x = 64) in;
#include "include/vegetation_cull_common.glsl"
shared uint s_scan[64];
// floor(a*b/n) for a < n, b <= n without 32-bit overflow: exact long division of the 64-bit product.
uint mulDiv(uint a, uint b, uint n) {
    uint hi, lo;
    umulExtended(a, b, hi, lo);
    if (hi == 0u) return lo / n;
    uint rem = hi, q = 0u;
    for (int i = 31; i >= 0; --i) {
        uint carry = rem >> 31;
        rem = (rem << 1) | ((lo >> uint(i)) & 1u);
        if (carry != 0u || rem >= n) { rem -= n; q |= 1u << uint(i); }
    }
    return q;
}
void main() {
    uint r = gl_WorkGroupID.y * P.flags.y + gl_WorkGroupID.x;
    if (r >= P.counts.x || counts[r] == 0u) return;
    uint start = offsets[r];
    uint end = r + 1u < P.counts.x ? offsets[r + 1u] : args[8];
    if (end <= start) return;
    uint quota = end - start, n = counts[r];
    VegRegion R = region[r];
    uint lid = gl_LocalInvocationIndex, seen = 0u;
    for (uint c = R.first; c < R.last; c += 64u) {
        uint id = c + lid;
        bool keep = id < R.last && survives(unpackVegetation(inst[id]), P.flags.x != 0u);
        uint v = keep ? 1u : 0u;
        s_scan[lid] = v;
        barrier();
        for (uint off = 1u; off < 64u; off <<= 1u) {
            uint t = lid >= off ? s_scan[lid - off] : 0u;
            barrier();
            v += t;
            s_scan[lid] = v;
            barrier();
        }
        uint j = seen + v - 1u;   // this survivor's rank in the region
        if (keep && j < n) {
            uint slot = mulDiv(j, quota, n);
            if (mulDiv(j + 1u, quota, n) > slot) dense[start + slot] = id;
        }
        seen += s_scan[63];
        barrier();
        if (seen >= n) break;
    }
}
