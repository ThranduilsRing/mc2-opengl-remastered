// Read the cull pass's cached survivor bits after the prefix sum. Population
// order and the dense output's fixed cap are unchanged.
// The region writes only its own slot range [offsets[r], next start): under the visible
// cap the scan scaled those ranges, so the region keeps the survivors with the lowest fixed
// per-instance hash priority (stable under small camera moves), and a cull/compact disagreement can never
// spill into the next region's slots.
#version 450
#extension GL_GOOGLE_include_directive : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_ballot : require
layout(local_size_x = 64) in;
#include "include/vegetation_cull_common.glsl"
shared uint s_sub[64];   // per-subgroup kept totals (hash-thinned survivors) for the current 64-instance chunk
// Fixed per-instance priority: independent of the camera, so a tiny move only changes survivors whose priority sits at the
// moving threshold instead of reshuffling the whole region. murmur3 fmix32 avalanche so adjacent ids are uncorrelated.
float keepPriority(uint id) {
    uint h = id;
    h ^= h >> 16u; h *= 0x85ebca6bu; h ^= h >> 13u; h *= 0xc2b2ae35u; h ^= h >> 16u;
    return float(h >> 8u) * (1.0 / 16777216.0);
}
// Conservative root test; the vertex shader retains the exact deformation test.
bool nearFoot(VegInstance i) {
    uint frame = i.atlasFrame;
    uint atlasIdx = (frame & 8u) != 0u ? (frame & 3u) : min(frame & 15u, 7u);
    if (atlasIdx >= 4u || ((frame >> 4u) & 3u) == 3u) return false;
    for (uint k = 0u; k < uint(P.grid.w); ++k) {
        uint base = uint(P.grid.z) + k * 4u;
        vec3 foot = uintBitsToFloat(uvec3(blockVis[base], blockVis[base + 1u], blockVis[base + 2u]));
        if (length(i.pos.xy - foot.xy) < (foot.z + max(1.0, foot.z * 0.25)) * 1.01 + 0.05) return true;
    }
    return false;
}
void main() {
    // Indirect dispatch over the visible regions: w is the position in visList, which also indexes counts[] and offsets[].
    uint w = gl_WorkGroupID.x;
    if (counts[w] == 0u) return;
    uint start = offsets[w];
    uint end = w + 1u < args[12] ? offsets[w + 1u] : args[8];
    if (end <= start) return;
    uint quota = end - start, n = counts[w];
    VegRegion R = region[visList[w]];
    uint lid = gl_LocalInvocationIndex, kept = 0u;
    // Under the cap keep the survivors whose fixed priority is below a threshold set ~3 sigma under quota/n, so the kept count
    // almost never exceeds the quota (no sequential cut-off of the tail); unfilled slots take the no-geometry marker below.
    // Uncapped (quota == n) every survivor is kept in order, as before.
    float thr = quota >= n ? 2.0 : float(quota) / float(n) * max(0.5, 1.0 - 3.0 * inversesqrt(float(quota)));
    for (uint c = R.first; c < R.last; c += 64u) {
        uint id = c + lid;
        bool keep = id < R.last && (surviveBits[id >> 5u] & (1u << (id & 31u))) != 0u && keepPriority(id) < thr;
        uvec4 ballot = subgroupBallot(keep);
        if (subgroupElect()) s_sub[gl_SubgroupID] = subgroupBallotBitCount(ballot);
        barrier();
        uint before = 0u, chunk = 0u;
        for (uint s = 0u; s < gl_NumSubgroups; ++s) { uint t = s_sub[s]; if (s < gl_SubgroupID) before += t; chunk += t; }
        uint r = kept + before + subgroupBallotExclusiveBitCount(ballot);   // this survivor's rank among the kept
        if (keep && r < quota)   // rare overshoot only: the highest-index kept drop
            dense[start + r] = id | (nearFoot(unpackVegetation(inst[id])) ? 0x80000000u : 0u);
        kept += chunk;
        barrier();
    }
    // Unfilled slots (kept < quota) get the no-geometry marker the vertex stage skips.
    for (uint r = kept + lid; r < quota; r += 64u) dense[start + r] = 0x7fffffffu;
}
