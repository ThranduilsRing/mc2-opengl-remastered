// Render-only static-prop occlusion. Bounds are projected with this draw's matrix.
// One dispatch: each prop projects locally, picks its pyramid level and samples it
// through a literal-index switch (a non-uniform index into a sampler array is undefined on AMD).
#version 450
#extension GL_GOOGLE_include_directive : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#include "../include/gpu_abi_static_prop_instance.gen.hglsl"
#include "../include/axis.hglsl"
layout(local_size_x = 64) in;
// Slots past the real mip count repeat the last level; lod is clamped below mipCount.
layout(set = 0, binding = 0) uniform sampler2D levelDepth[16];
layout(std430, set = 0, binding = 1) buffer Visibility { uint culled; uint visible[]; };
layout(std430, set = 0, binding = 2) readonly buffer Instances { GpuStaticPropInstance instances[]; };
struct LocalBounds { vec4 lo; vec4 hi; };
layout(std430, set = 0, binding = 3) readonly buffer TypeBounds { LocalBounds types[]; };
layout(push_constant) uniform Params {
    uint count; uint reserved; uint typeCount; uint levels;
    mat4 worldToClip;
    vec4 viewportDepth;
} params;

// Ceil ladder uses exact integer 2x2 footprints, including odd extents.
float farthestIn(sampler2D level, vec4 pixels, uint lod) {
    float scale = float(1u << lod);
    ivec2 hi = textureSize(level, 0) - 1;
    ivec2 p0 = clamp(ivec2(floor(pixels.xy / scale)), ivec2(0), hi);
    ivec2 p1 = clamp(ivec2(floor(pixels.zw / scale)), ivec2(0), hi);
    float farthest = 1.0;
    for (int y = p0.y; y <= p1.y; ++y)
        for (int x = p0.x; x <= p1.x; ++x)
            farthest = min(farthest, texelFetch(level, ivec2(x, y), 0).r);
    return farthest;
}

float farthestAtLod(vec4 pixels, uint lod) {
    switch (lod) {
        case 0u:  return farthestIn(levelDepth[0],  pixels, 0u);
        case 1u:  return farthestIn(levelDepth[1],  pixels, 1u);
        case 2u:  return farthestIn(levelDepth[2],  pixels, 2u);
        case 3u:  return farthestIn(levelDepth[3],  pixels, 3u);
        case 4u:  return farthestIn(levelDepth[4],  pixels, 4u);
        case 5u:  return farthestIn(levelDepth[5],  pixels, 5u);
        case 6u:  return farthestIn(levelDepth[6],  pixels, 6u);
        case 7u:  return farthestIn(levelDepth[7],  pixels, 7u);
        case 8u:  return farthestIn(levelDepth[8],  pixels, 8u);
        case 9u:  return farthestIn(levelDepth[9],  pixels, 9u);
        case 10u: return farthestIn(levelDepth[10], pixels, 10u);
        case 11u: return farthestIn(levelDepth[11], pixels, 11u);
        case 12u: return farthestIn(levelDepth[12], pixels, 12u);
        case 13u: return farthestIn(levelDepth[13], pixels, 13u);
        case 14u: return farthestIn(levelDepth[14], pixels, 14u);
        default:  return farthestIn(levelDepth[15], pixels, 15u);
    }
}

// Preserves the CPU reference's keep rules: any unprojectable corner keeps the prop.
bool propHidden(uint id) {
    GpuStaticPropInstance inst = instances[id];
    if (inst.typeID >= params.typeCount || types[inst.typeID].lo.w == 0) return false;
    LocalBounds local = types[inst.typeID];
    vec2 lo = vec2(3.402823466e+38), hi = -lo;
    float nearest = 0;
    for (int corner = 0; corner < 8; ++corner) {
        vec4 p = vec4((corner & 1) != 0 ? local.hi.x : local.lo.x,
                      (corner & 2) != 0 ? local.hi.y : local.lo.y,
                      (corner & 4) != 0 ? local.hi.z : local.lo.z, 1);
        precise vec3 stuff = vec3(0);
        for (int a = 0; a < 3; ++a)
            for (int k = 0; k < 4; ++k) stuff[a] += p[k] * inst.modelMatrix[a][k];
        vec4 world = vec4(mc2ToRender(stuff), 1);
        precise vec4 clip = vec4(0);
        for (int a = 0; a < 4; ++a)
            for (int k = 0; k < 4; ++k) clip[a] += params.worldToClip[k][a] * world[k];
        if (!(clip.w > 1e-5)) return false;
        vec3 ndc = clip.xyz / clip.w;
        ndc.z += params.viewportDepth.z;
        if (any(isnan(ndc)) || any(isinf(ndc)) || ndc.z < 0 || ndc.z >= 1 ||
            any(lessThanEqual(ndc.xy, vec2(-1))) || any(greaterThanEqual(ndc.xy, vec2(1)))) return false;
        vec2 pixels = (ndc.xy + 1) * 0.5 * params.viewportDepth.xy;
        lo = min(lo, pixels); hi = max(hi, pixels);
        nearest = max(nearest, ndc.z);
    }
    // The pyramid was built from depth drawn with the frame's sub-pixel TAA jitter (<= 0.5 px) while this
    // projection is unjittered: widen the box by that jitter plus the one texel of conservatism.
    vec4 box = vec4(max(vec2(0), floor(lo - 0.5) - 1), min(params.viewportDepth.xy - 1, ceil(hi + 0.5) + 1));
    float extent = max(box.z - box.x, box.w - box.y);
    uint lod = 0u;
    while (lod + 1 < params.levels && float(1u << lod) < extent) ++lod;
    return nearest < farthestAtLod(box, lod) - 0.00002;
}

void main() {
    uint id = gl_GlobalInvocationID.x;
    // No early return: out-of-range lanes must still reach the subgroup op.
    bool inRange = id < params.count;
    bool hidden = inRange && propHidden(id);
    if (inRange) visible[id] = hidden ? 0u : 1u;
    uint n = subgroupAdd(hidden ? 1u : 0u);
    if (subgroupElect() && n != 0u) atomicAdd(culled, n);
}
