#version 460
#extension GL_EXT_ray_query : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference_uvec2 : require
#extension GL_GOOGLE_include_directive : require
#include "include/prop_array_bucket.glsl"

// RT scene material probe (MC2_VK_RT_SELFTEST, vk_rt_scene.cpp probeMaterials): one invocation per ray, a ray query against the scene TLAS with the
// alpha-cutout test every ray-visible consumer must run (docs/rt-scene-contract.md). Host-side bindings: vk_rt_descriptors.h kSceneProbeBindings.
// rays[2*i] = (origin.xyz, tMin), rays[2*i+1] = (direction.xyz, tMax).
// results[2*i] = (hit, t, primitiveId, instanceCustomIndex); results[2*i+1] = (material row, albedo layer, packet / tile, flags), all -1 on a miss.
// Material row of a hit = instance SBT record offset + geometry index (one geometry per prop packet, one per terrain tile).

layout(local_size_x = 64) in;

struct MaterialRow {         // vk_rt_scene.h MaterialRow, 32 bytes
    int albedoLayer;
    uint flags;
    float alphaCut;
    int materialId;
    float uvScaleX;
    float uvScaleY;
    uint firstIndex;         // into uvIndex: this geometry's triangles, 3 rebased VBO vertex indices each
    uint packet;
};
const uint kMatAlphaOn = 1u;
const uint kMatCutout = 2u;

layout(buffer_reference, std430, buffer_reference_align = 4) readonly buffer Floats { float v[]; };

layout(set = 0, binding = 0) uniform accelerationStructureEXT uTlas;
layout(set = 0, binding = 1, std430) readonly buffer Rays { vec4 rays[]; };
layout(set = 0, binding = 2, std430) writeonly buffer Results { vec4 results[]; };
layout(set = 0, binding = 3, std430) readonly buffer Materials { MaterialRow rows[]; };
layout(set = 0, binding = 4, std430) readonly buffer UvIndex { uint uvIndex[]; };
layout(set = 0, binding = 5) uniform sampler2DArray uAlphaOff;
// PROP-ARRAY-BUCKETS: the alpha-ON size buckets on bindings 6..9 (MaterialRow.albedoLayer carries the bucket).
layout(set = 0, binding = 6) uniform sampler2DArray uAlphaOn;
layout(set = 0, binding = 7) uniform sampler2DArray uAlphaOn1;
layout(set = 0, binding = 8) uniform sampler2DArray uAlphaOn2;
layout(set = 0, binding = 9) uniform sampler2DArray uAlphaOn3;

float alphaOnAt(int layer, vec2 uv) {
    const vec3 tc = vec3(uv, float(propBucketLayer(layer)));
    switch (propBucketOf(layer)) {
        case 1: return textureLod(uAlphaOn1, tc, 0.0).a;
        case 2: return textureLod(uAlphaOn2, tc, 0.0).a;
        case 3: return textureLod(uAlphaOn3, tc, 0.0).a;
        default: return textureLod(uAlphaOn, tc, 0.0).a;
    }
}
// The alpha-OFF size buckets: bucket 0 on binding 5, buckets 1..3 on bindings 10..12.
layout(set = 0, binding = 10) uniform sampler2DArray uAlphaOff1;
layout(set = 0, binding = 11) uniform sampler2DArray uAlphaOff2;
layout(set = 0, binding = 12) uniform sampler2DArray uAlphaOff3;

float alphaOffAt(int layer, vec2 uv) {
    const vec3 tc = vec3(uv, float(propBucketLayer(layer)));
    switch (propBucketOf(layer)) {
        case 1: return textureLod(uAlphaOff1, tc, 0.0).a;
        case 2: return textureLod(uAlphaOff2, tc, 0.0).a;
        case 3: return textureLod(uAlphaOff3, tc, 0.0).a;
        default: return textureLod(uAlphaOff, tc, 0.0).a;
    }
}

layout(push_constant) uniform Push {
    uvec2 vbo;               // the static-prop VBO device address (40-byte vertices, uv at +24)
    uint stride;
    uint mode;               // 0: alpha-tested cutouts; 1: every candidate committed (the opaque reference)
} pc;

vec2 vertexUv(uint v) {
    Floats f = Floats(pc.vbo);
    const uint base = (v * pc.stride + 24u) / 4u;
    return vec2(f.v[base], f.v[base + 1u]);
}

// The raster's cut (color_prop_tier1.frag): fract(uv) * uvScale on the packet's layer at mip 0, kept when alpha >= the threshold.
bool alphaKeeps(MaterialRow m, uint prim, vec2 bary) {
    if (m.albedoLayer < 0) return true;
    const uint i = m.firstIndex + 3u * prim;
    const vec2 uv = vertexUv(uvIndex[i]) * (1.0 - bary.x - bary.y) + vertexUv(uvIndex[i + 1u]) * bary.x + vertexUv(uvIndex[i + 2u]) * bary.y;
    const vec2 st = fract(uv) * vec2(m.uvScaleX, m.uvScaleY);
    const float a = (m.flags & kMatAlphaOn) != 0u ? alphaOnAt(m.albedoLayer, st) : alphaOffAt(m.albedoLayer, st);
    return a >= m.alphaCut;
}

void main() {
    const uint i = gl_GlobalInvocationID.x;
    if (2u * i + 1u >= uint(results.length())) return;

    const vec4 o = rays[2u * i];
    const vec4 d = rays[2u * i + 1u];

    rayQueryEXT rq;
    rayQueryInitializeEXT(rq, uTlas, gl_RayFlagsNoneEXT, 0xFF, o.xyz, o.w, d.xyz, d.w);
    while (rayQueryProceedEXT(rq)) {
        if (rayQueryGetIntersectionTypeEXT(rq, false) != gl_RayQueryCandidateIntersectionTriangleEXT) continue;
        const uint row = rayQueryGetIntersectionInstanceShaderBindingTableRecordOffsetEXT(rq, false) + uint(rayQueryGetIntersectionGeometryIndexEXT(rq, false));
        bool keep = pc.mode == 1u || row >= uint(rows.length());
        if (!keep) keep = (rows[row].flags & kMatCutout) == 0u ||
                          alphaKeeps(rows[row], uint(rayQueryGetIntersectionPrimitiveIndexEXT(rq, false)), rayQueryGetIntersectionBarycentricsEXT(rq, false));
        if (keep) rayQueryConfirmIntersectionEXT(rq);
    }

    if (rayQueryGetIntersectionTypeEXT(rq, true) == gl_RayQueryCommittedIntersectionTriangleEXT) {
        const uint row = rayQueryGetIntersectionInstanceShaderBindingTableRecordOffsetEXT(rq, true) + uint(rayQueryGetIntersectionGeometryIndexEXT(rq, true));
        results[2u * i] = vec4(1.0, rayQueryGetIntersectionTEXT(rq, true), float(rayQueryGetIntersectionPrimitiveIndexEXT(rq, true)),
                               float(rayQueryGetIntersectionInstanceCustomIndexEXT(rq, true)));
        if (row < uint(rows.length()))
            results[2u * i + 1u] = vec4(float(row), float(rows[row].albedoLayer), float(rows[row].packet), float(rows[row].flags));
        else
            results[2u * i + 1u] = vec4(float(row), -1.0, -1.0, -1.0);
    } else {
        results[2u * i] = vec4(0.0, 0.0, -1.0, -1.0);
        results[2u * i + 1u] = vec4(-1.0);
    }
}
