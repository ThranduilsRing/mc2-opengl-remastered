#version 460
#extension GL_EXT_ray_query : require

// RT infrastructure self-test: one invocation per ray, a ray query against the test TLAS.
// rays[2*i] = (origin.xyz, tMin), rays[2*i+1] = (direction.xyz, tMax); results[i] = (hit, t, primitiveId, instanceCustomIndex).
// Host-side bindings: vk_rt_descriptors.h (kSmokeBindings).

layout(local_size_x = 64) in;

layout(set = 0, binding = 0) uniform accelerationStructureEXT uTlas;
layout(set = 0, binding = 1, std430) readonly buffer Rays { vec4 rays[]; };
layout(set = 0, binding = 2, std430) writeonly buffer Results { vec4 results[]; };

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= uint(results.length())) return;

    vec4 o = rays[2u * i];
    vec4 d = rays[2u * i + 1u];

    rayQueryEXT rq;
    rayQueryInitializeEXT(rq, uTlas, gl_RayFlagsOpaqueEXT, 0xFF, o.xyz, o.w, d.xyz, d.w);
    while (rayQueryProceedEXT(rq)) {}

    if (rayQueryGetIntersectionTypeEXT(rq, true) == gl_RayQueryCommittedIntersectionTriangleEXT) {
        results[i] = vec4(1.0, rayQueryGetIntersectionTEXT(rq, true), float(rayQueryGetIntersectionPrimitiveIndexEXT(rq, true)),
                          float(rayQueryGetIntersectionInstanceCustomIndexEXT(rq, true)));
    } else {
        results[i] = vec4(0.0, 0.0, -1.0, -1.0);
    }
}
