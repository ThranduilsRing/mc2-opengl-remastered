#version 450
#extension GL_GOOGLE_include_directive : require
// Static shadow bake, terrain self-shadow: a cone march over the visible, crest-filtered surface from P = (x, y, max(terrain, water)). The visibility is the
// tightest clearance of the ray over the cone's half-height at each step, so a ridge's shadow has a penumbra that grows with the distance to the ridge.
#include "include/shadow_bake_common.glsl"

const float kTerrainConeScale = 2.5;   // LOCKSTEP with mc2shadow::kTerrainConeScale

layout(local_size_x = 8, local_size_y = 8) in;

void main() {
    ivec2 t = ivec2(gl_GlobalInvocationID.xy);
    int n = uB.regionInfo.x;
    if (t.x >= n || t.y >= n) return;
    vec2 xy = bakeTexelWorld(t);
    float z = max(bakeTerrainHeight(xy), uB.region.w);
    float horiz = length(uB.sun.xy);
    float vis = 1.0;
    if (horiz > 1e-4 && z < uB.march.x) {
        vec2 dir = uB.sun.xy / horiz;
        float tanAlt = uB.sun.z / horiz;
        float cosAlt2 = horiz * horiz;                  // |L| = 1, so cos^2(alt) = |L.xy|^2
        // Vertical half-height of the (widened, kTerrainConeScale in shadow_bake_math.h) sun disk per unit of horizontal distance.
        float cone = kTerrainConeScale * uB.sun.w / max(cosAlt2, 0.05);
        float stepLen = uB.march.y;
        float dist = stepLen * (0.5 + bakeHash(t));
        for (int i = 0; i < 96; ++i) {
            float rayZ = bakeTerrainRayHeight(z, dist, tanAlt);
            if (rayZ > uB.march.x || dist > uB.march.w) break;
            float h = bakeTerrainHeight(xy + dir * dist);
            vis = min(vis, bakeTerrainMarchVisibility(rayZ, h, dist, cone));
            if (vis <= 0.0) break;
            stepLen *= uB.march.z;
            dist += stepLen;
        }
    }
    imageStore(u_terrain, t, vec4(vis));
}
