#ifndef MC2_LIGHT_POOL_ATTENUATION_HGLSL
#define MC2_LIGHT_POOL_ATTENUATION_HGLSL

// Shared object/terrain pool attenuation. nearD returns the scaled contact radius.
bool lpa_falloff(vec3 delta, bool mover, float moverScale, int soft,
                 inout float nearD, float farD, float ooD,
                 out float len, out float falloff)
{
    if (mover && moverScale < 0.999) {
        float scale = max(moverScale, 0.05);
        farD *= scale; nearD *= scale; ooD /= scale;
    }
    float distance2 = dot(delta, delta);
    if (farD <= 0.0 || distance2 >= farD * farD) return false;
    len = sqrt(distance2);
    falloff = (len <= nearD) ? 1.0 : (farD - len) * ooD;
    if (soft != 0) {
        float t = clamp(falloff, 0.0, 1.0);
        falloff = t * t * (3.0 - 2.0 * t);
    }
    return true;
}

// LOCAL-LIGHTS-1: spot cone packed into the pool record's lightType by the producer
// (gos_terrain_lighting.cpp PackPoolLightType; lockstep):
//   bits 0-3   type (1 point, 2 spot, 3 terrain; 0 = skip)
//   bits 4-7   shadow tile + 1 (0 = unshadowed)
//   bits 8-15  octahedral aim u, bits 16-23 aim v (MC2 world frame)
//   bits 24-31 cos(outer half-angle) * 255; 0 = omni (no cone)
// Omni records keep the exact pre-cone value (type in the low bits only), so the
// equality tests of the vertex-lighting compute still see them; coned records fail
// those tests on purpose and light only through these per-fragment loops.

// LIGHTS-R3: the pool term's slow radial gradient quantised into concentric bands in the
// 8-bit scene target. A screen-space triangular dither of +-1 LSB (two interleaved-gradient
// noise taps) breaks the bands; unlit fragments (no pool) are returned untouched.
vec3 lpa_dither(vec3 c)
{
    if (max(c.r, max(c.g, c.b)) <= 0.0) return c;
    const vec3 k = vec3(0.06711056, 0.00583715, 52.9829189);
    float n1 = fract(k.z * fract(dot(gl_FragCoord.xy, k.xy)));
    float n2 = fract(k.z * fract(dot(gl_FragCoord.xy + vec2(19.0, 47.0), k.xy)));
    return max(c + vec3((n1 + n2 - 1.0) * (1.0 / 255.0)), vec3(0.0));
}

vec3 lpa_octDecode(vec2 e)
{
    vec3 v = vec3(e, 1.0 - abs(e.x) - abs(e.y));
    if (v.z < 0.0) v.xy = (1.0 - abs(v.yx)) * vec2(v.x >= 0.0 ? 1.0 : -1.0, v.y >= 0.0 ? 1.0 : -1.0);
    return normalize(v);
}
vec3 lpa_spotAim(uint packed)
{
    return lpa_octDecode(vec2(float((packed >> 8) & 255u), float((packed >> 16) & 255u)) * (2.0 / 255.0) - 1.0);
}
// LOCAL-LIGHTS-3: attenuation of a coned light, replacing the omni pool ramp. Angular:
// measured in ANGLE (not cosine, whose flat top read as a disc with a thin blurred
// rim), a squared smooth roll-off from the axis to the outer half-angle. Distance:
// inverse-square with a smooth window to zero at farD, so the pool fades gradually
// from the lamp instead of ending at an edge. Omni lights keep `omniFalloff`.
// LIGHTS-R4: acos for x in [0,1] (Abramowitz-Stegun 4.4.45, |err| < 7e-5 rad): no transcendental per fragment
// and light. Negative cosines are behind the lamp and clamp to the outer edge, so [0,1] suffices.
float lpa_acos01(float x)
{
    x = clamp(x, 0.0, 1.0);
    return sqrt(1.0 - x) * (1.5707288 + x * (-0.2121144 + x * (0.0742610 - 0.0187293 * x)));
}
float lpa_spotCone(vec3 delta, uint packed, float len, float farD, float omniFalloff)
{
    uint c = packed >> 24;
    if (c == 0u) return omniFalloff;
    float outer = lpa_acos01(float(c) * (1.0 / 255.0));
    float cd = dot(delta, lpa_spotAim(packed)) / max(len, 1e-3);
    float t = clamp(1.0 - lpa_acos01(cd) / max(outer, 1e-3), 0.0, 1.0);
    float angular = t * t * (3.0 - 2.0 * t) * t;
    float d0 = 0.35 * farD;
    float r = len / max(farD, 1e-3);
    float window = clamp(1.0 - r * r * r * r, 0.0, 1.0);
    float distance = window * window / (1.0 + (len / d0) * (len / d0));
    return angular * distance * 2.0;
}

// LOCAL-LIGHTS-2: shadow of a coned light that holds a tile of the local-light shadow atlas (bits 4-7 of lightType).
// The projection is rebuilt from the record exactly as GameOS/gameos/local_light_shadow.h lightMatrix() (lockstep).
// The includer defines MC2_LOCAL_SHADOW_ATLAS and declares `sampler2D u_localShadowAtlas` (D16 depth, 4x2 tiles of 512^2);
// without it every light is unshadowed.
float lpa_localShadow(vec3 wp, vec3 lightPos, uint packed, float farD)
{
#ifdef MC2_LOCAL_SHADOW_ATLAS
    uint tile1 = (packed >> 4) & 15u;
    if (tile1 == 0u) return 1.0;
    vec3 f = lpa_spotAim(packed);
    vec3 up = abs(f.z) < 0.95 ? vec3(0.0, 0.0, 1.0) : vec3(1.0, 0.0, 0.0);
    vec3 r = normalize(cross(f, up));
    vec3 u = cross(r, f);
    float c = float(packed >> 24) * (1.0 / 255.0);
    float tanHalf = sqrt(max(1.0 - c * c, 1e-6)) / max(c, 1e-3) * 1.05;
    vec3 d = wp - lightPos;
    float z = dot(d, f);
    const float kNear = 12.0;   // clips the lamp's own housing (local_light_shadow.h kNear)
    if (z <= kNear) return 1.0;
    vec2 ndc = vec2(dot(d, r), dot(d, u)) / (z * tanHalf);
    if (abs(ndc.x) >= 1.0 || abs(ndc.y) >= 1.0) return 1.0;
    uint t = tile1 - 1u;
    vec2 tileUV = clamp(ndc * 0.5 + 0.5, vec2(1.0 / 512.0), vec2(1.0 - 1.0 / 512.0));
    vec2 uv = (vec2(float(t % 4u), float(t / 4u)) + tileUV) * vec2(0.25, 0.5);
    float F = max(farD, kNear + 1.0);
    float A = F / (F - kNear), B = -F * kNear / (F - kNear);
    vec4 g = textureGather(u_localShadowAtlas, uv, 0);
    vec4 zs = B / min(g - A, vec4(-1e-6));   // occluder distance along the aim; cleared 1.0 -> far
    // Receivers carry no normal here, and ground-hugging casters (pads, rubble, flat props) sit at the
    // receiving terrain's own depth at grazing angles: a generous distance-scaled bias keeps them from
    // shadowing the ground under them while props and trees (tens of units tall) still cast.
    float bias = 3.0 + 0.06 * z;
    vec4 lit = step(vec4(z - bias), zs);
    vec2 w = fract(uv * vec2(2048.0, 1024.0) - 0.5);
    return mix(mix(lit.w, lit.z, w.x), mix(lit.x, lit.y, w.x), w.y);
#else
    return 1.0;
#endif
}
#endif
