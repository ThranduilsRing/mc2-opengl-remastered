#ifndef __SHADOW_HGLSL__
#define __SHADOW_HGLSL__

uniform sampler2DShadow shadowMap;
uniform mat4 lightSpaceMatrix;
uniform int enableShadows;
uniform float shadowSoftness;  // penumbra radius in texels, default 2.5

// SHADOW-DIST-FADE-1 (env MC2_SHADOW_DIST_FADE, killswitch =0): classic
// penumbra model on the DYNAMIC shadow term only. The occluder->receiver
// distance ALONG THE LIGHT RAY is estimated from the shadow-map depth delta
// (probed with the comparison sampler at 4 offsets x 4 reference depths --
// no raw depth fetch needed), and drives BOTH:
//   - the PCF radius: near-caster contact shadows stay crisp (a mech's feet),
//     far-caster shadow regions blur (its head, and especially the km-long
//     low-sun silhouettes stretched by projection), and
//   - an opacity fade that reaches fully-lit at MC2_SHADOW_DIST_FADE world
//     units of ray distance -- "a pixel-perfect shadow halfway across the
//     map" dissolves to nothing instead.
// The macro is injected by every compile site that injects MC2_SHADOW_CSM
// (terrain chunk, generic material variations incl. gos_terrain.frag, the
// overlay/decal programs, and shadow_screen.frag) so all dynamic receivers
// stay in lockstep. Value 0.0 (killswitch or non-injecting site) folds the
// whole block away -> current behavior.
#ifndef MC2_SHADOW_DIST_FADE_WU
#define MC2_SHADOW_DIST_FADE_WU 0.0
#endif
const float kShadowDistFadeWu = float(MC2_SHADOW_DIST_FADE_WU);
// SHADOW-DONUT-FIX-1: max opacity the distance fade may remove (env
// MC2_SHADOW_DIST_FADE_MAX, default 0.65). 1.0 = old behavior (full erase at
// the fade distance); lower = far-caster shadow interiors keep a soft floor
// ("softer fade on the interior" user note). Injected alongside the _WU macro
// at every compile site; non-injecting sites use this default.
#ifndef MC2_SHADOW_DIST_FADE_MAX_F
#define MC2_SHADOW_DIST_FADE_MAX_F 0.65
#endif
const float kShadowDistFadeMax = float(MC2_SHADOW_DIST_FADE_MAX_F);
// SHADOW-FADE-CONTINUOUS-1 (env MC2_SHADOW_FADE_CONT, killswitch =0): the
// original occluder-distance ladder probed only 4 discrete reference depths,
// quantizing dNorm to 5 levels -> spatially-coherent STEP boundaries in both
// the fade opacity and the penumbra radius (user-visible: stepped fade change
// along long shadows, blotchy dithered mech shadows). Continuous variant: 8
// midpoint references with a per-pixel half-step jitter on the whole ladder
// (reuses the existing rotation hash) -- halves the depth step and converts
// the residual staircase into fine unbiased noise instead of coherent bands.
#ifndef MC2_SHADOW_FADE_CONT_F
#define MC2_SHADOW_FADE_CONT_F 1
#endif

// 16-sample Poisson disk (well-distributed points in unit circle)
const vec2 poissonDisk[16] = vec2[](
    vec2(-0.94201624, -0.39906216),
    vec2( 0.94558609, -0.76890725),
    vec2(-0.09418410, -0.92938870),
    vec2( 0.34495938,  0.29387760),
    vec2(-0.91588581,  0.45771432),
    vec2(-0.81544232, -0.87912464),
    vec2(-0.38277543,  0.27676845),
    vec2( 0.97484398,  0.75648379),
    vec2( 0.44323325, -0.97511554),
    vec2( 0.53742981, -0.47373420),
    vec2(-0.26496911, -0.41893023),
    vec2( 0.79197514,  0.19090188),
    vec2(-0.24188840,  0.99706507),
    vec2(-0.81409955,  0.91437590),
    vec2( 0.19984126,  0.78641367),
    vec2( 0.14383161, -0.14100790)
);

// Gradient-adaptive PCF (poor-man's PCSS).
// fwidth(projCoords.z) measures how fast receiver depth changes in shadow space.
// Cliffs facing the light have high gradient (stair-step risk) → use tight PCF.
// Flat terrain has low gradient → can afford wide PCF for soft penumbra without banding.
float calcShadow(vec3 worldPos, vec3 normal, vec3 lightDir, int numTaps)
{
    if (enableShadows == 0) return 1.0;

#ifdef MC2_SHADOW_STATIC_BANDFIX_V2
    // STATIC-SHADOW-BANDING-2: normal-offset shadow receiver. The static map's
    // world-per-texel is large (~4.6 wu on mc2_01: full-map 4096^2 ortho), so a
    // sloping receiver crosses depth-texel thresholds in coherent diagonal
    // contour bands (measured: near-continuous grey levels => NOT PCF tap
    // quantization; band pitch ~1-2 texels => texel-geometry mechanism A).
    // Shift the sample point one texel along the receiver normal BEFORE
    // projecting — the textbook normal-offset fix. Texel world size is derived
    // from the light matrix itself: its xy rows scale by 1/orthoHalf, so
    // texelWorld = 2*orthoHalf/mapSize. Callers compiled without the define
    // are byte-identical.
    {
        float invR = length(vec3(lightSpaceMatrix[0][0],
                                 lightSpaceMatrix[1][0],
                                 lightSpaceMatrix[2][0]));
        float texelWorld = (invR > 1e-8)
                         ? 2.0 / (invR * float(textureSize(shadowMap, 0).x))
                         : 0.0;
        worldPos += normal * texelWorld;
        // SHADOW-BLOB-REGRESSION-FIX (2026-07-18, mc2_10 field report): after
        // using the caller's macro slope normal for the receiver offset above,
        // RESET to flat-up for the back-face guard + slope bias below. The v2
        // default-ON flip surfaced giant faceted black blotches at long
        // distance / low sun (mc2_10 corner view): on light-facing slopes the
        // macro normal drives NdotL -> ~1, collapsing the slope bias from up
        // to 0.005 to its 0.002 floor, so the coarse static-map caster mesh
        // self-shadows entire triangles (A/B diag: static map carried the
        // blobs, dynamic clean). The normal-offset receiver above is the part
        // that actually cures the banding (mc2_01 f1800 stripe amplitude
        // patch-C 3.67 -> 1.26 with offset-only, vs 1.45 full-v2), so keep it
        // and return bias/guard to the legacy flat-up semantics.
        normal = vec3(0.0, 0.0, 1.0);
    }
#endif
    vec4 lsPos = lightSpaceMatrix * vec4(worldPos, 1.0);
    vec3 projCoords = lsPos.xyz / lsPos.w;
    projCoords.xy = projCoords.xy * 0.5 + 0.5;  // z already [0,1] (ZERO_TO_ONE light ortho)

    // Outside shadow map — fully lit
    if (projCoords.z > 1.0 || projCoords.z < 0.0) return 1.0;
    if (projCoords.x < 0.0 || projCoords.x > 1.0 ||
        projCoords.y < 0.0 || projCoords.y > 1.0) return 1.0;

    // Back-face guard
    float NdotL = max(dot(normal, lightDir), 0.0);
    if (NdotL < 0.05) return 1.0;

    // Slope-dependent depth bias
    float bias = max(0.005 * (1.0 - NdotL), 0.002);
    float currentDepth = projCoords.z - bias;

    // Per-pixel rotation to break banding (stratified sampling)
    float angle = 6.2831853 * fract(sin(dot(worldPos.xz, vec2(12.9898, 78.233))) * 43758.5453);
    float ca = cos(angle), sa = sin(angle);
    mat2 rot = mat2(ca, sa, -sa, ca);

    // Adaptive PCF radius based on light-space depth gradient.
    // High gradient (cliff/ridge facing light) → tighten radius to hide stair-stepping.
    // Low gradient (flat terrain) → widen radius for soft penumbra without banding.
    float depthGradient = length(vec2(dFdx(projCoords.z), dFdy(projCoords.z)));
    float hardness = clamp(depthGradient * 180.0, 0.0, 1.0);
    float adaptiveScale = mix(2.4, 0.8, hardness);   // SHADOW-SHARPEN: 3.2->2.4 flat (sharper mech shadow)

    // Poisson disk sampling with variable tap count
    vec2 texelSize = 1.0 / vec2(textureSize(shadowMap, 0));
    float radius = max(shadowSoftness, 0.5) * adaptiveScale;
    float shadow = 0.0;
    int taps = clamp(numTaps, 1, 16);
    for (int i = 0; i < taps; i++) {
        vec2 offset = rot * poissonDisk[i] * radius * texelSize;
        shadow += texture(shadowMap, vec3(projCoords.xy + offset, currentDepth));
    }
    shadow /= float(taps);

    return mix(0.4, 1.0, shadow);
}

// Convenience overload — full quality (backwards compatible)
float calcShadow(vec3 worldPos, vec3 normal, vec3 lightDir)
{
    return calcShadow(worldPos, normal, lightDir, 16);
}

// Dynamic object shadow map (mech shadows, camera-centered, per-frame).
//
// THE FROZEN META-FIX: calcDynamicShadow(vec3,vec3,vec3,int) (and its 3-arg
// overload) keep an IDENTICAL signature in BOTH variants. shadow.hglsl is
// #include'd by 7 shaders; NONE of them change their call site. Only the
// uniform DECLARATIONS swap under MC2_SHADOW_CSM, and ALL cascade-select /
// array-sampler / blend logic lives INSIDE the function body.
//
//  - OFF (default): legacy sampler2DShadow + single mat4 (byte-identical).
//  - ON           : sampler2DArrayShadow + mat4[N] + int dynamicCsmCount,
//                   with per-cascade projection-test selection + overlap blend.
//
// All cascades are in raw MC2 Z-up light space (z already [0,1], ZERO_TO_ONE);
// no GL-NDC/D3D clip stage is introduced per cascade.
#ifdef MC2_SHADOW_CSM
#ifndef MC2_SHADOW_CSM_MAX
#define MC2_SHADOW_CSM_MAX 3
#endif
uniform sampler2DArrayShadow dynamicShadowArray;
uniform mat4 dynamicCascadeMatrices[MC2_SHADOW_CSM_MAX];
uniform int  dynamicCsmCount;        // 1..MC2_SHADOW_CSM_MAX
uniform float dynamicCascadeTexelWorld[MC2_SHADOW_CSM_MAX]; // 2*cRad/mapSize, world units
uniform float csmDepthSpan;          // (farP-nearP) of shared CSM ortho z-row
// Per-cascade shadow resolution: the LAST cascade (index dynamicCsmCount-1, the
// map-centered full-map catch-all) lives in a SEPARATE lower-res 2D depth texture
// instead of the high-res near-cascade array. Its own texel-world (computed at the
// separate texture's resolution) drives the depth bias.
uniform sampler2DShadow dynamicFullMapShadow;
uniform float dynamicFullMapTexelWorld;
uniform int  enableDynamicShadows;

// Sample one cascade layer with the same gradient-adaptive Poisson PCF the
// legacy path uses. Returns visibility in [0,1] (1 = lit). projCoords already
// in [0,1] xy and [0,1] z for that cascade.
float csmSampleLayer(vec3 projCoords, int layer, vec3 worldPos, float NdotL, int numTaps)
{
    // Stage 3: per-cascade texel-scaled depth bias. Scale the cascade's world-texel
    // footprint into NDC depth units via the shared ortho span, then apply slope.
    float slope = max(1.0 - NdotL, 0.0);
    float texelBias = 1.5 * dynamicCascadeTexelWorld[layer] / max(csmDepthSpan, 1.0);
    float bias = max(0.0012 * slope, 0.0004) + texelBias;
    float currentDepth = projCoords.z - bias;

    float angle = 6.2831853 * fract(sin(dot(worldPos.xz, vec2(12.9898, 78.233))) * 43758.5453);
    float ca = cos(angle), sa = sin(angle);
    mat2 rot = mat2(ca, sa, -sa, ca);

    float depthGradient = length(vec2(dFdx(projCoords.z), dFdy(projCoords.z)));
    float hardness = clamp(depthGradient * 180.0, 0.0, 1.0);
    float adaptiveScale = mix(2.4, 0.8, hardness);   // SHADOW-SHARPEN: 3.2->2.4 flat (sharper mech shadow)

    vec2 texelSize = 1.0 / vec2(textureSize(dynamicShadowArray, 0).xy);
    float radius = max(shadowSoftness, 0.5) * adaptiveScale;

    // SHADOW-DIST-FADE-1: occluder-distance estimate -> penumbra + fade.
    // SHADOW-DONUT-FIX-1: take the MAX per-probe staircase occlusion instead of
    // AVERAGING all 16 taps. Averaging made the estimate collapse at silhouette
    // EDGES (half the probe ring lands outside the caster -> mixed occluder/sky
    // -> small delta -> no fade/blur) while the interior got the full delta ->
    // full fade -- rendering every tree shadow as a dark OUTLINE ring around a
    // washed interior (the "donut"). MAX means any edge pixel whose probe ring
    // reaches the interior sees the same occluder distance the interior sees,
    // so blur + fade are uniform across the whole silhouette. Fade is also
    // capped at kShadowDistFadeMax (softer interior; see macro above).
    float distFade = 0.0;
    if (kShadowDistFadeWu > 0.0) {
        float fadeNdc = kShadowDistFadeWu / max(csmDepthSpan, 1.0);
        float occP = 0.0;
        vec2 searchR = radius * 3.0 * texelSize;
#if MC2_SHADOW_FADE_CONT_F != 0
        // SHADOW-FADE-CONTINUOUS-1: 8 midpoint refs + per-pixel ladder jitter
        // (see macro block above for the staircase mechanism writeup).
        float ladderJit = fract(angle * 0.15915494) - 0.5;   // [-0.5,0.5)
        for (int p = 0; p < 4; ++p) {
            vec2 uv = projCoords.xy + rot * poissonDisk[p] * searchR;
            float o = 0.0;
            for (int q = 0; q < 8; ++q) {
                float stepN = clamp((float(q) + 0.5 + ladderJit) * 0.125, 0.0, 1.0);
                o += 1.0 - texture(dynamicShadowArray,
                        vec4(uv, float(layer), currentDepth - fadeNdc * stepN));
            }
            occP = max(occP, o * 0.125);
        }
        float dNorm = occP;                 // ~ occluder ray-distance / fade distance
#else
        for (int p = 0; p < 4; ++p) {
            vec2 uv = projCoords.xy + rot * poissonDisk[p] * searchR;
            float o = 0.0;
            for (int q = 1; q <= 4; ++q) {
                o += 1.0 - texture(dynamicShadowArray,
                        vec4(uv, float(layer), currentDepth - fadeNdc * 0.25 * float(q)));
            }
            occP = max(occP, o);
        }
        float dNorm = occP * 0.25;          // ~ occluder ray-distance / fade distance
#endif
        radius *= 1.0 + 4.0 * dNorm;        // penumbra grows with occluder distance
        distFade = kShadowDistFadeMax * smoothstep(0.45, 1.0, dNorm);
    }

    float shadow = 0.0;
    int taps = clamp(numTaps, 1, 16);
    for (int i = 0; i < taps; i++) {
        vec2 offset = rot * poissonDisk[i] * radius * texelSize;
        // sampler2DArrayShadow: (s, t, layer, ref)
        shadow += texture(dynamicShadowArray, vec4(projCoords.xy + offset, float(layer), currentDepth));
    }
    shadow /= float(taps);
    return mix(shadow, 1.0, distFade);
}

// Per-cascade shadow resolution: sample the LAST cascade from the separate
// lower-res 2D depth texture (dynamicFullMapShadow). Mirrors csmSampleLayer's
// gradient-adaptive Poisson PCF but uses the 2D sampler + dynamicFullMapTexelWorld.
float csmSampleFullMap(vec3 projCoords, vec3 worldPos, float NdotL, int numTaps)
{
    float slope = max(1.0 - NdotL, 0.0);
    float texelBias = 1.5 * dynamicFullMapTexelWorld / max(csmDepthSpan, 1.0);
    float bias = max(0.0012 * slope, 0.0004) + texelBias;
    float currentDepth = projCoords.z - bias;

    float angle = 6.2831853 * fract(sin(dot(worldPos.xz, vec2(12.9898, 78.233))) * 43758.5453);
    float ca = cos(angle), sa = sin(angle);
    mat2 rot = mat2(ca, sa, -sa, ca);

    float depthGradient = length(vec2(dFdx(projCoords.z), dFdy(projCoords.z)));
    float hardness = clamp(depthGradient * 180.0, 0.0, 1.0);
    float adaptiveScale = mix(2.4, 0.8, hardness);

    vec2 texelSize = 1.0 / vec2(textureSize(dynamicFullMapShadow, 0).xy);
    float radius = max(shadowSoftness, 0.5) * adaptiveScale;

    // SHADOW-DIST-FADE-1: occluder-distance estimate -> penumbra + fade
    // (lockstep with csmSampleLayer; this is the cascade that carries the
    // giant far-field silhouettes, so the fade matters most here).
    // SHADOW-DONUT-FIX-1: MAX per-probe estimate + capped fade (see
    // csmSampleLayer for the donut mechanism writeup).
    float distFade = 0.0;
    if (kShadowDistFadeWu > 0.0) {
        float fadeNdc = kShadowDistFadeWu / max(csmDepthSpan, 1.0);
        float occP = 0.0;
        vec2 searchR = radius * 3.0 * texelSize;
#if MC2_SHADOW_FADE_CONT_F != 0
        // SHADOW-FADE-CONTINUOUS-1: 8 midpoint refs + per-pixel ladder jitter.
        float ladderJit = fract(angle * 0.15915494) - 0.5;   // [-0.5,0.5)
        for (int p = 0; p < 4; ++p) {
            vec2 uv = projCoords.xy + rot * poissonDisk[p] * searchR;
            float o = 0.0;
            for (int q = 0; q < 8; ++q) {
                float stepN = clamp((float(q) + 0.5 + ladderJit) * 0.125, 0.0, 1.0);
                o += 1.0 - texture(dynamicFullMapShadow,
                        vec3(uv, currentDepth - fadeNdc * stepN));
            }
            occP = max(occP, o * 0.125);
        }
        float dNorm = occP;
#else
        for (int p = 0; p < 4; ++p) {
            vec2 uv = projCoords.xy + rot * poissonDisk[p] * searchR;
            float o = 0.0;
            for (int q = 1; q <= 4; ++q) {
                o += 1.0 - texture(dynamicFullMapShadow,
                        vec3(uv, currentDepth - fadeNdc * 0.25 * float(q)));
            }
            occP = max(occP, o);
        }
        float dNorm = occP * 0.25;
#endif
        radius *= 1.0 + 4.0 * dNorm;
        distFade = kShadowDistFadeMax * smoothstep(0.45, 1.0, dNorm);
    }

    float shadow = 0.0;
    int taps = clamp(numTaps, 1, 16);
    for (int i = 0; i < taps; i++) {
        vec2 offset = rot * poissonDisk[i] * radius * texelSize;
        shadow += texture(dynamicFullMapShadow, vec3(projCoords.xy + offset, currentDepth));
    }
    shadow /= float(taps);
    return mix(shadow, 1.0, distFade);
}

// Project worldPos into cascade `layer`; out-of-range -> inside=false.
bool csmProject(vec3 worldPos, int layer, out vec3 projCoords)
{
    vec4 lsPos = dynamicCascadeMatrices[layer] * vec4(worldPos, 1.0);
    projCoords = lsPos.xyz / lsPos.w;
    projCoords.xy = projCoords.xy * 0.5 + 0.5;
    if (projCoords.z > 1.0 || projCoords.z < 0.0) return false;
    if (projCoords.xy != clamp(projCoords.xy, 0.0, 1.0)) return false;
    return true;
}

float calcDynamicShadow(vec3 worldPos, vec3 normal, vec3 lightDir, int numTaps)
{
    if (enableDynamicShadows == 0) return 1.0;

    float NdotL = max(dot(normal, lightDir), 0.0);
    if (NdotL < 0.05) return 1.0;

    int count = clamp(dynamicCsmCount, 1, MC2_SHADOW_CSM_MAX);

    //PORT-BEGIN:calcDynamicShadowCsm
    // Select the first (tightest) cascade that contains worldPos. Cascade 0 is
    // the near/highest-resolution slice; fall through to coarser ones. When the
    // sample lands inside the OVERLAP toward the next cascade's near edge, blend
    // smoothly to hide the resolution seam.
    for (int c = 0; c < count; ++c) {
        vec3 pc;
        if (!csmProject(worldPos, c, pc)) continue;

        // Per-cascade shadow resolution: last cascade is the separate full-map 2D
        // texture; near cascades sample their array layer.
        float vis = (c == count - 1)
                  ? csmSampleFullMap(pc, worldPos, NdotL, numTaps)
                  : csmSampleLayer(pc, c, worldPos, NdotL, numTaps);

        // Overlap blend with the next cascade near the outer edge of this one.
        if (c + 1 < count) {
            // distance to nearest xy border in [0,0.5]; band = outer 12%.
            vec2 d = min(pc.xy, 1.0 - pc.xy);
            float edge = min(d.x, d.y);
            const float band = 0.06;
            if (edge < band) {
                vec3 pc2;
                if (csmProject(worldPos, c + 1, pc2)) {
                    // The next cascade is the full-map one when c+1 == count-1.
                    float vis2 = (c + 1 == count - 1)
                               ? csmSampleFullMap(pc2, worldPos, NdotL, numTaps)
                               : csmSampleLayer(pc2, c + 1, worldPos, NdotL, numTaps);
                    float t = smoothstep(0.0, band, edge);   // 0 at border -> use next
                    vis = mix(vis2, vis, t);
                }
            }
        }

        return mix(0.4, 1.0, vis);
    }

    // Outside every cascade -> fully lit (static map covers the far field).
    return 1.0;
    //PORT-END:calcDynamicShadowCsm
}

#else  // ---- legacy single dynamic shadow map (default, byte-identical) ----

uniform sampler2DShadow dynamicShadowMap;
uniform mat4 dynamicLightSpaceMatrix;
uniform int enableDynamicShadows;

float calcDynamicShadow(vec3 worldPos, vec3 normal, vec3 lightDir, int numTaps)
{
    if (enableDynamicShadows == 0) return 1.0;

    vec4 lsPos = dynamicLightSpaceMatrix * vec4(worldPos, 1.0);
    vec3 projCoords = lsPos.xyz / lsPos.w;
    projCoords.xy = projCoords.xy * 0.5 + 0.5;  // z already [0,1] (ZERO_TO_ONE light ortho)

    if (projCoords.z > 1.0 || projCoords.z < 0.0) return 1.0;
    if (projCoords.x < 0.0 || projCoords.x > 1.0 ||
        projCoords.y < 0.0 || projCoords.y > 1.0) return 1.0;

    float NdotL = max(dot(normal, lightDir), 0.0);
    if (NdotL < 0.05) return 1.0;

    float bias = max(0.005 * (1.0 - NdotL), 0.002);
    float currentDepth = projCoords.z - bias;

    float angle = 6.2831853 * fract(sin(dot(worldPos.xz, vec2(12.9898, 78.233))) * 43758.5453);
    float ca = cos(angle), sa = sin(angle);
    mat2 rot = mat2(ca, sa, -sa, ca);

    // Same gradient-adaptive PCF as static shadow (see calcShadow above).
    float depthGradient = length(vec2(dFdx(projCoords.z), dFdy(projCoords.z)));
    float hardness = clamp(depthGradient * 180.0, 0.0, 1.0);
    float adaptiveScale = mix(2.4, 0.8, hardness);   // SHADOW-SHARPEN: 3.2->2.4 flat (sharper mech shadow)

    vec2 texelSize = 1.0 / vec2(textureSize(dynamicShadowMap, 0));
    float radius = max(shadowSoftness, 0.5) * adaptiveScale;

    // SHADOW-DIST-FADE-1 (legacy single-map variant): same occluder-distance
    // penumbra + fade. The legacy path has no csmDepthSpan uniform, so the
    // world-per-NDC-depth scale is recovered from the ortho light matrix z-row
    // (|row2| = 1/depthSpan for the ZERO_TO_ONE ortho).
    float distFade = 0.0;
    if (kShadowDistFadeWu > 0.0) {
        float invSpan = length(vec3(dynamicLightSpaceMatrix[0][2],
                                    dynamicLightSpaceMatrix[1][2],
                                    dynamicLightSpaceMatrix[2][2]));
        if (invSpan > 1e-8) {
            // SHADOW-DONUT-FIX-1: MAX per-probe estimate + capped fade (see
            // csmSampleLayer for the donut mechanism writeup).
            float fadeNdc = kShadowDistFadeWu * invSpan;
            float occP = 0.0;
            vec2 searchR = radius * 3.0 * texelSize;
#if MC2_SHADOW_FADE_CONT_F != 0
            // SHADOW-FADE-CONTINUOUS-1: 8 midpoint refs + per-pixel ladder jitter.
            float ladderJit = fract(angle * 0.15915494) - 0.5;   // [-0.5,0.5)
            for (int p = 0; p < 4; ++p) {
                vec2 uv = projCoords.xy + rot * poissonDisk[p] * searchR;
                float o = 0.0;
                for (int q = 0; q < 8; ++q) {
                    float stepN = clamp((float(q) + 0.5 + ladderJit) * 0.125, 0.0, 1.0);
                    o += 1.0 - texture(dynamicShadowMap,
                            vec3(uv, currentDepth - fadeNdc * stepN));
                }
                occP = max(occP, o * 0.125);
            }
            float dNorm = occP;
#else
            for (int p = 0; p < 4; ++p) {
                vec2 uv = projCoords.xy + rot * poissonDisk[p] * searchR;
                float o = 0.0;
                for (int q = 1; q <= 4; ++q) {
                    o += 1.0 - texture(dynamicShadowMap,
                            vec3(uv, currentDepth - fadeNdc * 0.25 * float(q)));
                }
                occP = max(occP, o);
            }
            float dNorm = occP * 0.25;
#endif
            radius *= 1.0 + 4.0 * dNorm;
            distFade = kShadowDistFadeMax * smoothstep(0.45, 1.0, dNorm);
        }
    }

    float shadow = 0.0;
    int taps = clamp(numTaps, 1, 16);
    for (int i = 0; i < taps; i++) {
        vec2 offset = rot * poissonDisk[i] * radius * texelSize;
        shadow += texture(dynamicShadowMap, vec3(projCoords.xy + offset, currentDepth));
    }
    shadow /= float(taps);
    shadow = mix(shadow, 1.0, distFade);

    return mix(0.4, 1.0, shadow);
}

#endif  // MC2_SHADOW_CSM

// Convenience overload — full quality (backwards compatible). Signature frozen
// and IDENTICAL in both variants.
float calcDynamicShadow(vec3 worldPos, vec3 normal, vec3 lightDir)
{
    return calcDynamicShadow(worldPos, normal, lightDir, 16);
}

#endif
