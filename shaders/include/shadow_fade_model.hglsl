#ifndef __SHADOW_FADE_MODEL_HGLSL__
#define __SHADOW_FADE_MODEL_HGLSL__
// shadow_fade_model.hglsl -- PURE-MATH core of the dynamic-shadow distance-fade /
// penumbra / sun-altitude-clamp model, shared VERBATIM by the GL shadow.hglsl
// (which passes its compile-time MC2_SHADOW_* macro constants) and the Vulkan
// terrain shaders via shaders/vulkan/include/lighting_shadow_vk.glsl (which pass
// the same values from a UBO). One definition => GL and VK cannot drift.
//
// VK-PARITY-SHADOW-1 (gap #4). Series folded in here: TERRAIN-SHADOW-GUARD-1
// (clamped-sun), SHADOW-DIST-FADE-1 / FADE-CONTINUOUS-1 / FADE-RAMP0-1 /
// DONUT-FIX-1 / ALT-SCALE-1 (see shadow.hglsl for the per-feature writeups).
// No uniforms, no samplers, no macros read here: every knob is a parameter.

// Exact GLSL mirror of mc2ClampShadowSunAltitude (gos_postprocess.cpp).
// d = normalized direction TOWARD the sun (MC2 Z-up); d.z = sin(altitude).
// minUp <= 0 -> identity (killswitch / non-injecting site).
vec3 mc2ShadowClampSunAltitudeP(vec3 d, float minUp)
{
    if (minUp <= 0.0) return d;          // killswitch / non-injecting site
    if (d.z >= minUp) return d;          // healthy sun: untouched
    float horiz = length(d.xy);
    float ch = sqrt(max(1.0 - minUp * minUp, 0.0));
    vec2 xy = (horiz > 1e-6) ? (d.xy / horiz * ch) : vec2(ch, 0.0);
    return vec3(xy, minUp);
}

// Returns vec2(radiusGain, fadeMaxEff) for this pixel's sun (SHADOW-ALT-SCALE-1).
vec2 mc2ShadowFadeGainsP(float sunAltSin, float fadeMax, bool altScale)
{
    if (altScale) {
        float soft = 1.0 - smoothstep(0.21, 0.57, clamp(sunAltSin, 0.0, 1.0));
        return vec2(mix(1.0, 4.0, soft), fadeMax * mix(0.25, 1.0, soft));
    }
    return vec2(4.0, fadeMax);
}

// Opacity fade from the occluder-distance estimate (dNorm in [0,1]).
// ramp0: SHADOW-FADE-RAMP0-1 continuous-from-contact; else legacy windowed onset.
float mc2ShadowDistFadeCurveP(float dNorm, float fadeMaxEff, bool ramp0)
{
    if (ramp0) return fadeMaxEff * dNorm * dNorm;
    return fadeMaxEff * smoothstep(0.45, 1.0, dNorm);
}

// SHADOW-FADE-CONTINUOUS-1 ladder helpers: per-pixel half-step jitter derived
// from the PCF rotation angle, and the q-th of 8 midpoint reference fractions.
float mc2ShadowLadderJitter(float angle)
{
    return fract(angle * 0.15915494) - 0.5;   // [-0.5,0.5)
}
float mc2ShadowLadderStepN(int q, float ladderJit)
{
    return clamp((float(q) + 0.5 + ladderJit) * 0.125, 0.0, 1.0);
}

#endif
