#ifndef __OBJECT_LIGHT_POOL_HGLSL__
#define __OBJECT_LIGHT_POOL_HGLSL__

#include "light_pool_attenuation.hglsl"

// VK-PARITY-MECH-1: object-side night light-pool walk (POOL-CONSUMERS-1), shared
// VERBATIM by the GL object shaders (via light_pools.hglsl::calcLightPools ->
// static_prop.frag / mech.frag / gos_tex_vertex_lighted.frag) and the VK tier-1
// mech and colour prop FSs (shaders/vulkan/mech_tier1.frag, color_prop_tier1.frag). One body, two backends.
//
// The INCLUDER must declare, before including this file:
//   struct PoolLight { ... }   (48B std430, lockstep with gos_terrain_lighting.h
//                               GpuTerrainLight)
//   poolLights[]               GL binding 28 / VK mech set0 binding 5
// All knobs arrive as parameters (GL passes its uniforms, VK its UBO fields; both
// from gos_terrain_lighting::GetObjectLightPoolParams), so this include declares
// no uniforms and no bindings.
//
// NOTE: bare float/vec types only -- no PREC qualifier.

// One ordered light contribution, shared by the uniform short walk and lists.
void olp_addPoolLight(int i, vec3 worldPosMC2, int poolSoft, float moverDim,
                      float moverScale, int moverMax, inout vec3 pool, inout vec3 poolMover)
{
    if (poolLights[i].lightType == 0u) return;
    bool  mover = poolLights[i]._plPad1 > 0.5;
    float nearD = poolLights[i].closeDistance;
    float len, falloff;
    if (!lpa_evaluate(worldPosMC2, poolLights[i].position, poolLights[i].lightType,
                      mover, moverScale, poolSoft, nearD, poolLights[i].farDistance,
                      poolLights[i].oneOverDistance, len, falloff)) return;
    vec3 plCol = poolLights[i].color * poolLights[i].intensity;
    if (mover) {
        plCol *= moverDim;
        if (moverMax != 0) {
            poolMover = max(poolMover, plCol * falloff);
            return;
        }
    }
    pool += plCol * falloff;
}

// Additive pool light reaching worldPosMC2 (MC2/Stuff frame). Mirrors the
// terrain_lod_chunk.frag loop exactly (soft tail, mover dim/scale/max-blend,
// tone compression), then applies the object-side scale.
vec3 olp_objectPoolLight(vec3 worldPosMC2, int numPoolLights, int poolSoft,
                         float moverDim, float moverScale, int moverMax,
                         int poolCompress, float objScale)
{
    if (numPoolLights <= 0 || objScale <= 0.0) return vec3(0.0);
    vec3 pool      = vec3(0.0);
    vec3 poolMover = vec3(0.0);
#ifdef MC2_OBJECT_SHORT_POOL
    // The stock runway scene packs fewer than 100 lights. Grid lookup and
    // dependent record loads cost more than this uniform, contiguous short walk.
    if (numPoolLights <= 128 && MC2_OBJECT_SHORT_POOL) {
        for (int i = 0; i < numPoolLights; ++i)
            olp_addPoolLight(i, worldPosMC2, poolSoft, moverDim, moverScale, moverMax, pool, poolMover);
    } else
#endif
    {
    int lo = 0, hi = numPoolLights;
    bool indexed = false;
#ifdef MC2_OBJECT_POOL_LIST
    lo = int(uRun.poolFirst);
    hi = lo + int(uRun.poolCount);
    if (lo == hi) return vec3(0.0);
#endif
#ifdef MC2_OBJECT_POOL_GRID
    if (poolGridInfo.x > 0u) {
        ivec2 cell = ivec2(floor((worldPosMC2.xy - poolGridMinInv.xy) * poolGridMinInv.zw));
        int dim = int(poolGridInfo.x);
        if (any(lessThan(cell, ivec2(0))) || any(greaterThanEqual(cell, ivec2(dim)))) return vec3(0.0);
        int word = 2 * (cell.y * dim + cell.x);
        lo = int(poolGridWords[word]);
        hi = lo + int(poolGridWords[word + 1]);
        if (lo == hi) return vec3(0.0);
        indexed = true;
    }
#endif
#ifdef MC2_OBJECT_TERRAIN_GRID
    if (uT.lightGridDim > 0) {
        ivec2 cell = ivec2(floor((worldPosMC2.xy - vec2(uT.lightGridMinX, uT.lightGridMinY)) *
                               vec2(uT.lightGridInvCellX, uT.lightGridInvCellY)));
        if (any(lessThan(cell, ivec2(0))) || any(greaterThanEqual(cell, ivec2(uT.lightGridDim)))) return vec3(0.0);
        uvec2 range = lightGridCells[cell.y * uT.lightGridDim + cell.x];
        lo = int(range.x); hi = int(range.x + range.y); indexed = true;
    }
#endif
    for (int k = lo; k < hi; ++k) {
        int i = k;
#ifdef MC2_OBJECT_POOL_GRID
        if (indexed) i = int(poolGridWords[poolGridInfo.y + uint(k)]);
        // A mod can enlarge the terrain pool beyond the existing object cap.
        if (i >= numPoolLights) continue;
#endif
#ifdef MC2_OBJECT_TERRAIN_GRID
        if (indexed) i = int(lightGridIndices[k]);
        if (i >= numPoolLights) continue;
#endif
        olp_addPoolLight(i, worldPosMC2, poolSoft, moverDim, moverScale, moverMax, pool, poolMover);
    }
    }
    pool += poolMover;
    vec3 outPool;
    if (poolCompress != 0)
        outPool = vec3(1.0) - exp(-1.6 * pool);
    else
        outPool = min(pool, vec3(1.0));
    return lpa_dither(outPool * objScale, worldPosMC2);
}

#endif // __OBJECT_LIGHT_POOL_HGLSL__
