#ifndef __PROP_DITHER_HGLSL__
#define __PROP_DITHER_HGLSL__

// Shared Bayer 4x4 ordered-dither alpha test for static props (BUILDING-GLASS-1).
// Used by GL shaders/static_prop.frag and VK shaders/vulkan/color_prop_tier1.frag
// so the two backends cannot drift. Thresholds are (index+0.5)/16, so they span
// (0,1) exclusive: a==0 always discards, a==1 never does (binary fence
// textures are unchanged). Indexed by gl_FragCoord.xy (&3).
//
// Returns true when the fragment must be discarded.
bool propBayerDitherDiscard(float alpha, vec2 fragCoordXY) {
    const float kBayer4[16] = float[16](
         0.5/16.0,  8.5/16.0,  2.5/16.0, 10.5/16.0,
        12.5/16.0,  4.5/16.0, 14.5/16.0,  6.5/16.0,
         3.5/16.0, 11.5/16.0,  1.5/16.0,  9.5/16.0,
        15.5/16.0,  7.5/16.0, 13.5/16.0,  5.5/16.0);
    int bx = int(fragCoordXY.x) & 3;
    int by = int(fragCoordXY.y) & 3;
    return alpha < kBayer4[by * 4 + bx];
}

#endif
