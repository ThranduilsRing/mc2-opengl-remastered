// Shared C++ / GLSL / Slang fog policy. Inputs stay in source world units;
// only mc2FogDistance derives effective distances. Never write them to camera data.
#ifndef MC2_FOG_POLICY_H
#define MC2_FOG_POLICY_H
#ifdef __cplusplus
#define MC2_FOG_INLINE inline
#else
#define MC2_FOG_INLINE
#endif

#define MC2_FOG_DISTANCE_SCALE 1.5f
#define MC2_FOG_HEIGHT_MAX_OPACITY 0.05f
#define MC2_FOG_EXP_COEFFICIENT (0.00006f / MC2_FOG_DISTANCE_SCALE)

MC2_FOG_INLINE bool mc2FogFinite(float value) {
    return value >= -3.402823e38f && value <= 3.402823e38f;
}
MC2_FOG_INLINE float mc2FogClamp(float value) {
    return value > 0.0f ? (value < 1.0f ? value : 1.0f) : 0.0f;
}
MC2_FOG_INLINE float mc2FogDistance(float source) {
    // Preserve invalid inputs for mc2FogRamp's fail-open validation; replacing
    // one endpoint with zero would create a spurious ramp in the GPU snapshot.
    return source * MC2_FOG_DISTANCE_SCALE;
}
// Equal/reversed endpoints are a hard step at start; invalid inputs disable fog.
MC2_FOG_INLINE float mc2FogRamp(float distance, float start, float full) {
    if (!mc2FogFinite(distance) || !mc2FogFinite(start) || !mc2FogFinite(full)) return 0.0f;
    if (distance <= start) return 0.0f;
    float span = full - start;
    if (!mc2FogFinite(span)) return 0.0f;
    if (span <= 0.0f) return 1.0f;
    return mc2FogClamp((distance - start) / span);
}
MC2_FOG_INLINE float mc2FogHaze(float distance, float sourceStart, float sourceFull) {
    if (!mc2FogFinite(sourceStart) || !mc2FogFinite(sourceFull)) return 0.0f;
    if (!mc2FogFinite(sourceStart * MC2_FOG_DISTANCE_SCALE) ||
        !mc2FogFinite(sourceFull * MC2_FOG_DISTANCE_SCALE)) return 0.0f;
    return mc2FogRamp(distance, mc2FogDistance(sourceStart), mc2FogDistance(sourceFull));
}
MC2_FOG_INLINE float mc2FogInvSpan(float start, float full) {
    float span = full - start;
    if (!mc2FogFinite(span) || !(span > 0.0f)) return 0.0f;
    float factor = 1.0f / span;
    return mc2FogFinite(factor) ? factor : 0.0f;
}
MC2_FOG_INLINE float mc2FogSmooth(float value) {
    float t = mc2FogClamp(value);
    return t * t * (3.0f - 2.0f * t);
}
// Height endpoints describe SURFACE elevation. No camera-altitude ramp.
// Degenerate/reversed height bands are disabled. Quantization rounds opacity
// down, so packed alpha can never exceed the 0.05 opacity bound (12/255).
MC2_FOG_INLINE float mc2FogHeightAlpha(float elevation, float start, float full) {
    if (!mc2FogFinite(elevation) || !mc2FogFinite(start) || !mc2FogFinite(full)) return 255.0f;
    float span = start - full;
    if (!(span > 0.0f) || !mc2FogFinite(span)) return 255.0f;
    float t = mc2FogClamp((start - elevation) / span);
    return 255.0f - float(int(MC2_FOG_HEIGHT_MAX_OPACITY * t * t * 255.0f));
}
// Spatial view-ray attenuation affects range haze only. Horizon rays retain
// full haze; downward rays fade over sin(elevation) 0.35..0.85. Overview (85deg)
// therefore cannot white out from camera-to-ground distance alone. Map-edge
// concealment and outside-fill are deliberately independent of this factor.
MC2_FOG_INLINE float mc2FogRangeViewFactor(float rayVerticalSin) {
    // Geometry pixels only: use ray slope independent of far-endpoint polarity.
    float slope = rayVerticalSin < 0.0f ? -rayVerticalSin : rayVerticalSin;
    return 1.0f - mc2FogSmooth(mc2FogRamp(slope, 0.35f, 0.85f));
}

// OOB has no depth surface. Fade only groundward rays, leaving the sky intact.
MC2_FOG_INLINE float mc2FogGroundHorizon(float elevationSin) {
    return mc2FogSmooth(mc2FogRamp(-elevationSin, 0.0f, 0.02f));
}

// Cloud-sea guard rail: the out-of-bounds deck never covers the playable map. A scene surface whose
// max(|x|,|y|) lies inside halfExtent - 1000 (the map minus its border ring) gets zero cloud alpha.
MC2_FOG_INLINE float mc2CloudSeaGuard(float surfaceMaxAbs, float halfExtent) {
    return mc2FogSmooth(mc2FogRamp(surfaceMaxAbs, halfExtent - 1000.0f, halfExtent - 700.0f));
}

// Dissolve the border water before its mesh ends. The caller supplies a rounded
// boundary distance; terrain still occludes the deck at its actual depth.
MC2_FOG_INLINE float mc2CloudSeaReplace(float surfaceMaxAbs, float wobble, float halfExtent, float aa) {
    float w = wobble > 250.0f ? 250.0f : (wobble < -250.0f ? -250.0f : wobble);
    return mc2FogSmooth(mc2FogRamp(surfaceMaxAbs + w, halfExtent - 1000.0f, halfExtent - 100.0f)) * mc2CloudSeaGuard(surfaceMaxAbs, halfExtent);
}

#undef MC2_FOG_INLINE
#endif

// GPU fog has one evaluator, used before opaque/effect composition.
#ifndef MC2_FOG_GPU
#define MC2_FOG_GPU 0
#endif
#if MC2_FOG_GPU
layout(set = MC2_FOG_SET, binding = MC2_FOG_BINDING, std140) uniform EdgeFogParams {
    mat4  invViewProj;
    vec3  u_fogColor;
    float _pad0;
    float u_halfExtent;
    float u_fogStart;
    float u_fogHeight;
    float u_fogMax;
    float u_waterElevation;
    // VK-PARITY-F3: FOG-HORIZON-CLAMP-1 (default ON in GL). @100/104/108.
    int   u_horizonClampEnabled;
    float u_horizonFadeStartSin;
    float u_horizonFadeEndSin;
    float u_hazeStart;   // @112 source wu (x1.5 via mc2FogDistance)
    float u_hazeFull;    // @116
    int   u_fogProfile;  // @120 0 = Stock
    float _pad1;         // @124
    // Analytic atmosphere (fid-1): extinction + height fog integrated along the view ray, HG sun in-scatter.
    vec4  u_atmoParams;  // @128 x quality (0 off, 1 low, 2 high), y ground extinction per wu, z height falloff per wu, w HG g
    vec4  u_atmoSun;     // @144 xyz unit toward the sun (world Z up), w in-scatter strength
    vec4  u_atmoColor;   // @160 rgb ambient scatter colour, w base elevation (wu)
};

// Returns (rgb colour, alpha) of the atmosphere layer for a view ray ending at the visible surface.
vec4 atmosphereLayer(vec3 camPos, vec3 surfPos)
{
    vec3 rd = surfPos - camPos;
    float d = length(rd);
    if (u_atmoParams.x < 0.5 || d < 1.0) return vec4(0.0);
    rd /= d;
    float k = u_atmoParams.z;
    float x = k * rd.z * d;
    float path = abs(x) < 1e-4 ? d : (1.0 - exp(-x)) / (k * rd.z);
    float camH = max(camPos.z - u_atmoColor.w, 0.0);
    float tau = u_atmoParams.y * exp(-min(k * camH, 30.0)) * path;
    float alpha = 1.0 - exp(-max(tau, 0.0));
    vec3 scatter = u_atmoColor.rgb;
    if (u_atmoParams.x > 1.5) {
        float g = u_atmoParams.w;
        float c = dot(rd, u_atmoSun.xyz);
        float phase = (1.0 - g * g) / pow(max(1.0 + g * g - 2.0 * g * c, 1e-3), 1.5);  // 1 = isotropic
        scatter += vec3(1.0, 0.86, 0.64) * (u_atmoSun.w * phase * clamp(u_atmoSun.z * 2.0, 0.0, 1.0));
    }
    return vec4(min(scatter, vec3(1.2)), alpha);
}

vec4 mc2WorldFog(vec3 worldPos, vec2 ndc) {
    if (u_halfExtent <= 0.0) return vec4(0.0);
    vec4 pNear = invViewProj * vec4(ndc, 1.0, 1.0);
    vec4 pFar = invViewProj * vec4(ndc, 0.0, 1.0);
    vec3 wNear = pNear.xyz / pNear.w;
    vec3 wFar = pFar.xyz / pFar.w;
    // Use the visible surface, so a camera below the cloud top still sees haze
    // on boundary cliffs and skirts rather than failing a plane intersection.
    float distFromEdge = u_halfExtent - max(abs(worldPos.x), abs(worldPos.y));

    float innerRamp   = 1.0 - smoothstep(0.0, mc2FogDistance(max(u_fogStart, 768.0)), distFromEdge);
    float outsideFill = step(0.0, -distFromEdge);

    // VK-PARITY-F3: FOG-HORIZON-CLAMP-1 (verbatim from shaders/edge_fog.frag). Full fog
    // at/below the horizon, fading to zero across [startSin,endSin], so the cloud bank
    // never bleeds into the sky. clamp==0 -> factor 1.0 (previous behaviour).
    float horizonFactor = 1.0;
    if (u_horizonClampEnabled != 0) {
        float elevSin = -normalize(wFar - wNear).z;
        horizonFactor = 1.0 - smoothstep(u_horizonFadeStartSin, u_horizonFadeEndSin, elevSin);
    }

    float d = length(worldPos - wNear);
    float rangeHaze = (u_fogProfile == 0)
        ? mc2FogSmooth(mc2FogRamp(d, mc2FogDistance(6000.0), mc2FogDistance(12000.0)))
        : mc2FogSmooth(mc2FogRamp(d, mc2FogDistance(u_hazeStart), mc2FogDistance(u_hazeFull)));
    rangeHaze *= mc2FogRangeViewFactor(-normalize(wFar - wNear).z);
    float stock = clamp(max(max(innerRamp, rangeHaze) * u_fogMax, outsideFill), 0.0, 1.0)
                  * horizonFactor;
    // Profiles 1-3 also fog past haze start above the horizon (horizonFactor not applied to the range term).
    float fogFactor = (u_fogProfile == 0) ? stock : max(stock, rangeHaze * u_fogMax);
    vec4 atmo = atmosphereLayer(wNear, worldPos);
    // Edge layer over the atmosphere layer: A = a2 + a1 (1 - a2), colour weighted by each layer's contribution.
    float outA = fogFactor + atmo.a * (1.0 - fogFactor);
    vec3 outC = outA > 1e-5 ? (u_fogColor * fogFactor + atmo.rgb * atmo.a * (1.0 - fogFactor)) / outA : u_fogColor;
    return vec4(outC, outA);
}
#endif
