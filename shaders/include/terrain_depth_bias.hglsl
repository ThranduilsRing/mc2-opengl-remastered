// Shared C++/GLSL layer factors. Reverse-Z: larger depth wins.
#ifndef TERRAIN_DEPTH_BIAS_HGLSL
#define TERRAIN_DEPTH_BIAS_HGLSL
#ifndef MC2_DEPTH_CONST
#define MC2_DEPTH_CONST const
#endif
MC2_DEPTH_CONST float TERRAIN_DEPTH_FUDGE = 0.0;
// Legacy names remain for non-Vulkan consumers.
MC2_DEPTH_CONST float VEG_DEPTH_BIAS = 0.00003;
MC2_DEPTH_CONST float OVERLAY_DEPTH_BIAS = 0.00005;
MC2_DEPTH_CONST float OBJECT_DEPTH_BIAS = 0.0001;
MC2_DEPTH_CONST float WATER_DEPTH_BIAS = 0.00025;
MC2_DEPTH_CONST float WATER_DEPTH_FUDGE_RASTER = 0.00025;
MC2_DEPTH_CONST float WATER_DEPTH_FUDGE_FAST = 0.00025;
// Match the former NDC offsets at d=1000, near=400 (z=0.4).
MC2_DEPTH_CONST float VEG_DEPTH_BIAS_REL = 0.000075;
MC2_DEPTH_CONST float OVERLAY_DEPTH_BIAS_REL = 0.000125;
MC2_DEPTH_CONST float OBJECT_DEPTH_BIAS_REL = 0.00025;
MC2_DEPTH_CONST float WATER_DEPTH_FUDGE_FAST_REL = 0.000625;
#undef MC2_DEPTH_CONST
#endif
