// render_contract.hglsl — Render Contract Registry GLSL helpers (phase 1).
//
// GBuffer1 (color attachment 1) is RGBA16F.
//   .rgb = normal-encoded (n * 0.5 + 0.5)
//   .a   = post-process shadow mask:
//          a > 0.5  → shadow_screen.frag skips this pixel (self-shadow handled)
//          a <= 0.5 → shadow_screen.frag applies post-shadow normally
//
// Every fragment shader that writes attachment 1 must use one of these
// helpers. No shader may write `GBuffer1 = vec4(...)` directly; a grep
// census in scripts/check-render-contract-gbuffer1.sh enforces this.
//
// Spec: docs/superpowers/specs/2026-04-26-render-contract-registry-design.md

#ifndef RENDER_CONTRACT_HGLSL
#define RENDER_CONTRACT_HGLSL

// Pixel handles its own shadow inside this shader. Used by terrain base,
// grass, terrain overlays, terrain decals.
PREC vec4 rc_gbuffer1_shadowHandled(PREC vec3 normal) {
    return vec4(normal * 0.5 + 0.5, 1.0);
}

// Pixel is eligible for screen-space shadow application by shadow_screen.frag.
// Used by static props and any future world-space object renderer with a
// G-buffer write.
PREC vec4 rc_gbuffer1_screenShadowEligible(PREC vec3 normal) {
    return vec4(normal * 0.5 + 0.5, 0.0);
}

// Pixel is a STATIC PROP (building) that is eligible for screen-space shadow
// RECEPTION (static shadow map) but must NOT receive the dynamic-cascade
// self-shadow. The CPU original never self-shadowed buildings; the hard
// terminator looks wrong on flat low-poly facets. Encoded as a THIRD mask
// class at a=0.25 — distinct from terrain (a=1.0) and mechs (a=0.0) with a
// comfortable float-precision margin on both sides.
// PROP-SHADOW-RECEIVE-1: MC2_PROP_SHADOW_RECEIVE=1 (default OFF) opts this
// class back into the (softened) dynamic CSM sample in shadow_screen.frag.
PREC vec4 rc_gbuffer1_screenShadowEligible_noSelfShadow(PREC vec3 normal) {
    return vec4(normal * 0.5 + 0.5, 0.25);
}

// PROP-ALPHA-SHADOW-CLASS-1: alpha-test CUTOUT prop. Same static-prop class as
// 0.25 — still inside the (0.1, 0.5] band, so BOTH rc_isStaticPropNoSelfShadow
// and the canonical rc_pixelHandlesOwnShadow threshold behave EXACTLY as before
// — but distinguishable, so the PROP-SHADOW-RECEIVE opt-in can skip it.
//
// WHO IS ACTUALLY IN THIS CLASS (CONTRACT-TRUTH-2). This paragraph used to read
// "alpha-test LATTICE prop (chain-link fence, railing, grating)" and named
// nothing else. That is not false so much as backwards about the membership:
// the class is every prop packet carrying ALPHA_TEST_BIT, and it is dominated
// by TREES. The bit has exactly two sources, both in
// GameOS/gameos/gos_static_prop_batcher.cpp:
//   * shape-level TG_TypeShape::alphaTestOn (:3325) — and the ONLY
//     SetAlphaTest(true) call sites in the engine are the tree shapes in
//     mclib/bdactor.cpp (:6255, :6289, :6337, :6387). EVERY tree is in here.
//   * per-texture-slot textureAlpha, OR'd in at draw time (:5235, :8911) —
//     binary-alpha cutout textures, which is where fences, gates and
//     multi-textured building faces actually enter.
// Reading "fence, railing, grating" and picturing a rare bit of set dressing is
// how a change to this class gets waved through as low-blast-radius. It lands
// on every tree on the map.
//
// Rationale: the shadow depth pass has no alpha discard, so a lattice writes
// its depth into the cascades as a SOLID slab; letting it RECEIVE that depth
// self-shadows the whole lattice uniformly (fence reads as a dark panel).
// CASTING is untouched — the caster set is assembled CPU-side in
// mclib/txmmgr.cpp and never consults GBuffer1 — so fences keep casting onto
// terrain, which they correctly do today.
//
// VALUE CHOICE — 0.1875, and NOT 0.375. This is load-bearing:
// shoreline.frag:22 (and shaders/vulkan/shoreline.frag:102) classify a WATER
// pixel as `myAlpha > 0.15 && myAlpha < 0.35` — a CONTINUOUS read of this same
// channel that does not go through any rc_* helper. The existing 0.25 prop
// class already sits inside that band. Picking 0.375 would have moved
// alpha-test props OUT of it and silently changed shoreline output, so the
// change would NOT have been the no-op it must be while RECEIVE is default-OFF.
// 0.1875 sits inside the water band exactly as 0.25 does, so every continuous
// reader is bit-for-bit unaffected.
//
// 0.1875 (= 3/16) is exactly representable in fp16 (GBuffer1 is RGBA16F). It
// clears the mech threshold (a <= 0.1) by 0.0875 and is 0.0625 from 0.25 —
// both margins are ~3 orders of magnitude above the fp16 ulp at this
// magnitude, matching the "comfortable float-precision margin" 0.25 claims.
PREC vec4 rc_gbuffer1_screenShadowEligible_noSelfShadow_alphaTest(PREC vec3 normal) {
    return vec4(normal * 0.5 + 0.5, 0.1875);
}

// Reader side — true when the pixel is a static prop (no dynamic self-shadow).
// Mid band (0.1, 0.5); below the terrain threshold (0.5) so it still enters
// shadow_screen.frag's object path, above the mech band (< 0.1).
// Matches BOTH 0.25 (solid prop) and 0.1875 (alpha-test cutout) by design.
//
// THAT SECOND NUMBER WAS WRONG UNTIL CONTRACT-TRUTH-2: it named the REJECTED
// value from the VALUE CHOICE block above -- a value this file has never
// emitted -- so the canonical description of the class table contradicted both
// its own rationale twenty lines up and its own code ten lines up, in the one
// file every other shader conforms to. The same stale constant had been copied
// into shaders/shadow_screen.frag. Nothing noticed, because nothing compared
// this prose against the constants the shaders actually emit;
// scripts/check-render-contract-alpha-classes.py now does exactly that, and
// would have failed the commit that wrote it.
bool rc_isStaticPropNoSelfShadow(PREC vec4 gbuffer1) {
    return gbuffer1.a > 0.1 && gbuffer1.a <= 0.5;
}

// Reader side — true only for the alpha-test CUTOUT sub-class (0.1875): every
// tree, plus binary-alpha fences/gates/building faces. See the membership note
// on the emitter above before assuming this is a niche class.
// Sub-band (0.1, 0.22] carves 0.1875 out of the (0.1, 0.5] prop band without
// disturbing it: 0.25 stays above 0.22, and the mech class stays at/below 0.1.
// Used SOLELY to exclude cutouts from the dynamic-cascade RECEIVE opt-in;
// every other consumer keeps treating them as ordinary static props.
bool rc_isAlphaTestProp(PREC vec4 gbuffer1) {
    return gbuffer1.a > 0.1 && gbuffer1.a <= 0.22;
}

// PRE-ENCODED-NORMAL VARIANT — same semantic as rc_gbuffer1_shadowHandled,
// but for callsites that emit a literal (0.5, 0.5, 1.0) without computing
// a normal (early-out / debug paths in gos_terrain.frag and the four sites
// in terrain_overlay.frag).
PREC vec4 rc_gbuffer1_shadowHandled_flatUp() {
    return vec4(0.5, 0.5, 1.0, 1.0);
}

// LEGACY DEBUG SENTINEL (intentionally legacy-named). Used only by the
// static_prop.frag debug paths that emit a sentinel color/normal pair
// without real lighting. Not a recommended pattern for new shaders;
// preserved here so the debug paths route through the registry rather
// than writing literals. The grep census enforces single-shader usage.
PREC vec4 rc_gbuffer1_legacyDebugSentinelScreenShadowEligible() {
    return vec4(0.0, 0.0, 1.0, 0.0);
}

// LEGACY ESCAPE HATCH (intentionally ugly name). Used only by the
// gos_terrain.frag water/shoreline paths (lines 533, 555, 591) that
// today write a CONTINUOUS materialAlpha into the post-shadow MASK
// channel. The mask is supposed to be binary; a continuous value here
// is an undocumented overload that flips shadow behavior based on water
// depth / shoreline blend. See spec section 3.1 (CONTRACT VIOLATION).
//
// DO NOT use this helper in any other shader. New callsites must use
// rc_gbuffer1_shadowHandled or rc_gbuffer1_screenShadowEligible. The
// grep census enforces single-shader usage.
//
// This helper exists only to preserve byte-identical pixel output through
// the inert phase. Resolution is follow-up F1 (split material alpha from
// shadow mask, possibly via bit-packing or a dedicated channel).
PREC vec4 rc_gbuffer1_legacyTerrainMaterialAlpha(PREC vec3 normal,
                                                  PREC float materialAlpha) {
    return vec4(normal * 0.5 + 0.5, materialAlpha);
}

// Reader side — used by shadow_screen.frag and any future post-process
// pass that gates on the mask.
//
// CANONICAL THRESHOLD DEFINITION. After commit 6, shadow_screen.frag
// must not directly threshold GBuffer1.a. This function is the sole
// canonical definition of the post-shadow mask threshold; any future
// change to the threshold value or storage encoding (e.g. follow-up F1
// bit-packing) modifies this function and nothing else.
bool rc_pixelHandlesOwnShadow(PREC vec4 gbuffer1) {
    return gbuffer1.a > 0.5;
}

#endif // RENDER_CONTRACT_HGLSL
