#ifndef WATER_SHORE_ANIMATION_HGLSL
#define WATER_SHORE_ANIMATION_HGLSL

// Scalar material math shared with the covering doctest. All distances are wu;
// phase is derived only from frame time and world position, never accumulated.
float wsa_depthFade(float depth)
{
    return smoothstep(0.0, 1.5, depth) * (1.0 - smoothstep(12.0, 32.0, depth));
}

float wsa_reach(float phase)
{
    return 22.0 + 16.0 * sin(phase); // 6..38 wu, five-second swash cycle
}

float wsa_crest(float distance, float reach, float aa)
{
    return 1.0 - smoothstep(2.0, 5.0 + aa, abs(distance - reach));
}

float wsa_wash(float distance, float reach, float aa)
{
    return 1.0 - smoothstep(0.0, reach + aa, distance);
}

#endif
