{
  "matrix_id": "shadow",
  "description": "Static bake and one current-frame mover map. Master shadows default on; quality controls resolution. Definitions only.",
  "default_missions": [
    "mc2_01",
    "mc2_17"
  ],
  "default_duration": 20,
  "entries": [
    {
      "id": "default",
      "description": "Default high quality shadows.",
      "env": {}
    },
    {
      "id": "shadow_off",
      "description": "Master shadow control.",
      "env": {
        "MC2_SHADOW_ENABLE": "0"
      }
    },
    {
      "id": "shadow_potato",
      "description": "Potato resolution with all receiver classes.",
      "env": {
        "MC2_OPTIONS_OVERRIDE": "ShadowQuality=0"
      }
    }
  ]
}
