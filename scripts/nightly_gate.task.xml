<?xml version="1.0" encoding="UTF-8"?>
<!-- Daily 04:30: scripts/nightly_gate.py = merge_gate.py --nightly (Sundays --weekly) on the published nifty in its own worktree A:\Games\mc2-nightly.
     Nightly stages: deploy + tier-1 rows + the slim, non-blocking mods-slim check (one short load per mod, reported per mod,
     never fails the gate); Sundays run the full mods battery instead. mc2-main's branch and state do not matter;
     the script refuses (rc 2) only when the nightly worktree has tracked changes.
     This file is a TEMPLATE: @PY@ is the full launcher path (the task's PATH has no `py`; the 04:30 run failed with 0x80070002).
     Render + register (orchestrator only): py -3 scripts\nightly_gate_task.py   (prints the schtasks /Create /XML command)
     Remove the dead one:          schtasks /Delete /TN "\mc2-smoke-overnight" /F
     Check / run now:              schtasks /Query /TN "\mc2-nightly-gate" /V /FO LIST   |   schtasks /Run /TN "\mc2-nightly-gate" -->
<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <Triggers>
    <CalendarTrigger>
      <StartBoundary>2026-11-07T04:30:00</StartBoundary>
      <Enabled>true</Enabled>
      <ScheduleByDay><DaysInterval>1</DaysInterval></ScheduleByDay>
    </CalendarTrigger>
  </Triggers>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <StartWhenAvailable>true</StartWhenAvailable>
    <!-- gate_wait may wait up to 2 h for another gate's quiet hold; a full nightly runs about 2 h (mods-slim adds up to ~15 min). -->
    <ExecutionTimeLimit>PT5H</ExecutionTimeLimit>
  </Settings>
  <Actions Context="Author">
    <Exec>
      <Command>@PY@</Command>
      <Arguments>-3 A:\Games\mc2-main\scripts\nightly_gate.py</Arguments>
      <WorkingDirectory>A:\Games\mc2-main</WorkingDirectory>
    </Exec>
  </Actions>
</Task>
