# The one core map of the box. Installed at /workspace/locks/cores.env; sourced by box_run's remote half, env.sh, the filler, quiet-slot and box-supervisor (repin).
# Box: one RTX 4060 (GPU 0) on cores 0-7 since 2026-11-08. 36-core box: builds, unit rows and CPU rows: cores 8-35.
BUILD_CPUS=8-35
# Game slots per GPU: box_run takes one of K flock files gpu<g>.s<k> (a counting semaphore), so K game rows share a GPU; they share that GPU cores below.
# MC2_BOX_GPU_SLOTS in the environment overrides this.
GPU_SLOTS=3
# The gate GPU: the one GPU a merge-gate row reserves exclusively (box_run's legacy gpu<n> file, the supervisor's intruder guard, env.sh's owner check).
# One RTX 4060 box: the gate GPU is the only GPU (0); the guard stops filler rows on it while a gate holds the lock.
GATE_GPU=0
GPU0_CPUS=0-7
