#version 450
// STEP-0 probe: VK compute READS the shared (GL-written) buffer GPU-side and
// copies each element into a plain VK readback buffer. If the CPU then sees the
// GL-written pattern in the readback buffer, VK read the GL write GPU-side with
// no CPU readback of the shared buffer — exactly the STEP-1 data path.
layout(local_size_x = 64) in;
layout(std430, binding = 0) readonly  buffer Shared   { uint v[]; } sh;
layout(std430, binding = 1) writeonly buffer Readback { uint v[]; } rb;
layout(push_constant) uniform PC { uint count; } pc;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.count) return;
    rb.v[i] = sh.v[i];
}
