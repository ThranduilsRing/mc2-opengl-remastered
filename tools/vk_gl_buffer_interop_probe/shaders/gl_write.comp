#version 430
// STEP-0 probe: GL compute WRITES into the VK-exportable, GL-imported buffer.
// One invocation per element; deterministic pattern the CPU can re-derive.
layout(local_size_x = 64) in;
layout(std430, binding = 0) buffer Shared { uint v[]; } sh;
uniform uint uCount;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= uCount) return;
    sh.v[i] = i * 7u + 3u;   // MUST match expected() in main.cpp
}
