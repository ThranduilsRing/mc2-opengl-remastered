{
  "schema": "mc2-scifi-artlang-1",
  "about": "One kit language for every primitive and assembly. Dimensions in metres, Z up, front faces -Y. Colours are LINEAR RGB. Derived from the MW5/MWO artist references (Godfrey Urban Warfare, Halim MW5 sets) and the stock MC2 textures; see docs/scifi-kit-art-review.md.",
  "grid": {
    "bay_m": 3.0,
    "sub_m": 0.75,
    "floor_m": 3.6,
    "wall_thickness_m": 0.40,
    "basis": "3m bay, 0.75m panel subdivision. Every primitive's width is a multiple of sub_m, so seams, plinth joints and coping joints meet across parts."
  },
  "profiles": {
    "chamfer": {"major": 0.30, "mid": 0.12, "minor": 0.045, "basis": "Godfrey: 45-degree chamfers on the primary masses, small chamfers on trims; no rounded bevels."},
    "plinth": {"height": 0.60, "proud": 0.18, "top_chamfer": 0.12, "material": "ferro", "basis": "Ferrocrete base course shared by every grounded part"},
    "base_band": {"height": 0.14, "material": "paint.accent", "basis": "Single thin accent band where the cladding meets the plinth (Godfrey C6 / Halim spacetower)"},
    "coping": {"height": 0.30, "overhang": 0.14, "chamfer": 0.10, "material": "paint.trim"},
    "reveal": {"depth": 0.32, "jamb": 0.24, "chamfer": 0.07, "material": "paint.trim", "basis": "Every opening sits in a chamfered reveal cut into a wall; openings never float"},
    "panel": {"seam": 0.035, "inset": 0.05, "face_chamfer": 0.045},
    "rivet_pitch": 0.375
  },
  "material_classes": {
    "wood": {"metallic": 0.0, "roughness": 0.88, "base": "timber cases, directional grain, fade and water dirt"},
    "canvas": {"metallic": 0.0, "roughness": 0.96, "base": "olive woven canvas, sewn folds and chalky fade"},
    "paint":  {"metallic": 0.0, "roughness": 0.62, "base": "painted metal; wears to primer then bare steel"},
    "metal":  {"metallic": 0.9, "roughness": 0.42, "base": "bare / galvanised steel; rusts"},
    "corr":   {"metallic": 0.0, "roughness": 0.66, "base": "corrugated sheet, painted or rusted; real corrugation geometry"},
    "ferro":  {"metallic": 0.0, "roughness": 0.90, "base": "ferrocrete; cracks, rust bleed from rebar, chips on edges"},
    "glass":  {"metallic": 0.0, "roughness": 0.08, "alpha": 0.85, "base": "armoured glazing; cracks then breaks"},
    "grate":  {"metallic": 0.9, "roughness": 0.55, "base": "grating and rails"},
    "rubber": {"metallic": 0.0, "roughness": 0.95, "base": "seals, bumpers, hoses, cable"},
    "gravel": {"metallic": 0.0, "roughness": 0.97, "base": "gravel roof membrane (Godfrey roofs)"},
    "hazard": {"metallic": 0.0, "roughness": 0.60, "base": "accent paint with black chevrons"},
    "brick":  {"metallic": 0.0, "roughness": 0.86, "base": "fired brick in running bond, mortar joints, soot and efflorescence"},
    "lamp":   {"metallic": 0.0, "roughness": 0.30, "emissive": true},
    "char":   {"metallic": 0.0, "roughness": 0.98, "base": "torn edges and burned interior, destroyed only"}
  },
